---
import Navbar from '../components/Navbar.astro';
import CartDrawer from '../components/CartDrawer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ManNeeds — Pure Indian Kitchen Essentials, Spices, Honey & Healthy Foods",
  description = "100% pure, unadulterated kitchen essentials, raw wild honey, cold-processed spices & healthy roasted snacks. Farm fresh, authentic taste, and zero artificial additives."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Dark Mode Initialization (Zero-Flicker Sync) -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('manneeds_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <!-- Navbar Component -->
    <Navbar />

    <!-- Main Page Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- ManNeeds Trust Badges Strip -->
    <section class="trust-banner">
      <div class="container trust-container">
        <div class="trust-item">
          <div class="trust-icon-box bg-green">🌿</div>
          <div>
            <strong>100% Pure & Clean</strong>
            <span>Zero adulteration or fillers</span>
          </div>
        </div>
        <div class="trust-item">
          <div class="trust-icon-box bg-orange">🌾</div>
          <div>
            <strong>Direct Farm Harvest</strong>
            <span>From honest Indian growers</span>
          </div>
        </div>
        <div class="trust-item">
          <div class="trust-icon-box bg-berry">🔬</div>
          <div>
            <strong>Lab Tested Purity</strong>
            <span>Zero synthetic dyes or preservatives</span>
          </div>
        </div>
        <div class="trust-item">
          <div class="trust-icon-box bg-yellow">⭐</div>
          <div>
            <strong>50,000+ Happy Kitchens</strong>
            <span>Delivered across 500+ Indian cities</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ManNeeds Footer -->
    <footer class="site-footer">
      <div class="container footer-container">
        <div class="footer-top-grid">
          <!-- Brand Column -->
          <div class="footer-brand-col">
            <a href="/" class="footer-logo">
              <span class="mn-brand">MAN<span class="mn-brand-accent">NEEDS</span></span>
              <span class="mn-sub">PURE KITCHEN ESSENTIALS</span>
            </a>
            <p class="footer-tagline">
              <strong>Purity from farm soil to kitchen tadka.</strong> We bring uncompromised, unadulterated spices, raw honey, stone-ground flours, and wholesome snacks directly to conscious homes.
            </p>
            <div class="social-links">
              <a href="#" aria-label="Instagram" class="social-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
              <a href="#" aria-label="YouTube" class="social-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
              </a>
              <a href="#" aria-label="Twitter / X" class="social-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
              </a>
            </div>
          </div>

          <!-- Links 1 -->
          <div class="footer-links-col">
            <h4 class="footer-heading">Shop Essentials</h4>
            <ul class="footer-list">
              <li><a href="#categories">Botanical & Herbal Powders</a></li>
              <li><a href="#categories">Healthy Roasted Snacks</a></li>
              <li><a href="#categories">Real Fruit Candies</a></li>
              <li><a href="#categories">Dried Fruit Chips</a></li>
              <li><a href="#categories">Raw Honey & Pure Elixirs</a></li>
            </ul>
          </div>

          <!-- Links 2 -->
          <div class="footer-links-col">
            <h4 class="footer-heading">Support & Care</h4>
            <ul class="footer-list">
              <li><a href="/inventory">Live Stock & Inventory Ledger</a></li>
              <li><a href="#bestsellers">Track Your Order</a></li>
              <li><a href="#categories">Pantry Food Guide</a></li>
              <li><a href="#bestsellers">Frequently Asked Questions</a></li>
              <li><a href="#bestsellers">Returns & Replacement Policy</a></li>
              <li><a href="#contact">WhatsApp Customer Care</a></li>
            </ul>
          </div>

          <!-- Newsletter Column -->
          <div class="footer-newsletter-col">
            <h4 class="footer-heading">Join The Family</h4>
            <p class="newsletter-desc">
              Get harvest updates, pure kitchen recipes, and an instant <strong>Flat 15% OFF</strong> voucher on your first box.
            </p>
            <form class="newsletter-form" id="newsletter-form">
              <input 
                type="email" 
                placeholder="Enter your email" 
                required 
                class="newsletter-input" 
                id="newsletter-email"
                aria-label="Email for Natural Food Family"
              />
              <button type="submit" class="btn btn-primary newsletter-btn" id="newsletter-submit-btn">
                Claim 15%
              </button>
            </form>
          </div>
        </div>

        <!-- Footer Bottom Bar -->
        <div class="footer-bottom">
          <p class="copyright">
            &copy; {new Date().getFullYear()} Clean Food & Kitchen Essentials. 100% Pure & Natural. All rights reserved.
          </p>
          <div class="footer-legal-links">
            <a href="#privacy">Privacy Policy</a>
            <a href="#terms">Terms of Service</a>
            <a href="#shipping">Shipping Policy</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Slide-Over Interactive Cart Drawer & Toast Notifications -->
    <CartDrawer />
  </body>
</html>

<style>
  #main-content {
    flex: 1;
  }

  /* Trust Banner */
  .trust-banner {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 2.25rem 0;
  }

  .trust-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .trust-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-container {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .trust-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .bg-green { background: var(--bg-tint-green); }
  .bg-orange { background: var(--bg-tint-orange); }
  .bg-berry { background: var(--bg-tint-berry); }
  .bg-yellow { background: var(--bg-tint-gold); }

  :global(html.dark) .trust-banner {
    background: var(--bg-surface);
  }

  :global(html.dark) .trust-icon-box {
    background: var(--bg-subtle) !important;
    border: 1px solid var(--border-subtle);
  }

  :global(html.dark) .site-footer,
  :global([data-theme="dark"]) .site-footer {
    background: #0E1115;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .trust-item strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .trust-item span {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  /* Site Footer */
  .site-footer {
    background: #153417;
    color: #F9FAFB;
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid rgba(229, 169, 60, 0.2);
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .footer-top-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-top-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
      gap: 2.5rem;
    }
  }

  .footer-logo {
    display: inline-flex;
    flex-direction: column;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .mn-brand {
    font-family: var(--font-heading);
    font-size: 1.95rem;
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: -0.03em;
  }

  .mn-brand-accent {
    color: var(--mn-cta);
  }

  .mn-sub {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--mn-accent-gold);
  }

  .footer-tagline {
    color: #C8D3C8;
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 330px;
  }

  .footer-tagline strong {
    color: #FFFFFF;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: #E5E7EB;
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    color: #FFFFFF;
    background: var(--mn-cta);
    transform: translateY(-2px);
  }

  .footer-heading {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: #FFFFFF;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-list a {
    color: #C8D3C8;
    font-size: 0.92rem;
    transition: color var(--transition-fast);
  }

  .footer-list a:hover {
    color: var(--mn-accent-gold);
    padding-left: 2px;
  }

  .newsletter-desc {
    color: #C8D3C8;
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .newsletter-desc strong {
    color: var(--mn-accent-gold);
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    padding: 0.75rem 1.15rem;
    font-size: 0.88rem;
    color: #FFFFFF;
    outline: none;
  }

  .newsletter-input:focus {
    border-color: var(--mn-cta);
  }

  .newsletter-btn {
    padding: 0.75rem 1.4rem;
    font-size: 0.88rem;
    flex-shrink: 0;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .copyright {
    color: #6B7280;
    font-size: 0.85rem;
  }

  .footer-legal-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal-links a {
    color: #9CA3AF;
    font-size: 0.85rem;
  }

  .footer-legal-links a:hover {
    color: #FFFFFF;
  }

  /* Mobile compact optimization (< 640px) */
  @media (max-width: 639px) {
    .trust-banner {
      padding: 1.25rem 0 !important;
    }

    .trust-container {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem !important;
    }

    .trust-item {
      gap: 0.5rem !important;
    }

    .trust-icon-box {
      width: 36px !important;
      height: 36px !important;
      font-size: 1.1rem !important;
    }

    .trust-item strong {
      font-size: 0.78rem !important;
    }

    .trust-item span {
      font-size: 0.68rem !important;
    }

    .site-footer {
      padding-top: 2rem !important;
      padding-bottom: 1.5rem !important;
    }

    .footer-top-grid {
      grid-template-columns: 1fr !important;
      gap: 1.5rem !important;
      margin-bottom: 1.5rem !important;
    }

    .footer-brand-col {
      margin-bottom: 0 !important;
    }

    .footer-tagline {
      font-size: 0.82rem !important;
      line-height: 1.45 !important;
      margin-bottom: 0.75rem !important;
    }

    .footer-heading {
      font-size: 0.95rem !important;
      margin-bottom: 0.5rem !important;
    }

    .footer-list {
      gap: 0.4rem !important;
    }

    .footer-list a {
      font-size: 0.82rem !important;
    }

    .newsletter-desc {
      font-size: 0.82rem !important;
      line-height: 1.4 !important;
      margin-bottom: 0.75rem !important;
    }

    .footer-bottom {
      flex-direction: column !important;
      gap: 0.75rem !important;
      text-align: center !important;
    }

    .footer-legal-links {
      justify-content: center !important;
      gap: 1rem !important;
    }
  }
</style>

<script>
  import { addSubscriber } from '../lib/db';

  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const input = document.getElementById('newsletter-email') as HTMLInputElement;
  const btn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement;

  if (form && input && btn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Submitting...';

      const res = await addSubscriber(email);
      if ((window as any).manneedsCart?.showToast) {
        (window as any).manneedsCart.showToast(res.message);
      } else {
        alert(res.message);
      }

      btn.disabled = false;
      btn.textContent = originalText || 'Claim 15%';
      if (res.success) {
        input.value = '';
      }
    });
  }
</script>
