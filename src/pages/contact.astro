---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact Us | ManNeeds" description="Contact ManNeeds customer care via WhatsApp, phone, or email.">
  <section class="section policy-section">
    <div class="container policy-container">
      <span class="badge badge-green">Customer Support</span>
      <h1 class="section-title">Contact ManNeeds</h1>
      <p class="policy-updated">We're here to help with orders, bulk inquiries, and product questions.</p>

      <div class="contact-cards-grid">
        <div class="policy-card">
          <h2>WhatsApp &amp; Phone Support</h2>
          <p><strong>+91 97489 73335</strong></p>
          <p>Mon – Sat, 10:00 AM to 7:00 PM IST</p>
          <a href="https://wa.me/919748973335?text=Hi%20ManNeeds!%20I%20need%20help." target="_blank" rel="noopener noreferrer" class="btn whatsapp-support-btn" style="width:fit-content;margin-top:0.25rem;">
            Chat on WhatsApp
          </a>
        </div>

        <div class="policy-card">
          <h2>Email Support</h2>
          <p><strong><a href="mailto:manneedsgroup@gmail.com">manneedsgroup@gmail.com</a></strong></p>
          <p>For order tracking, refunds, wholesale partnerships, and compliance inquiries. Typical response time: under 24 hours.</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .policy-section { padding: 3rem 0 4.5rem; background: var(--bg-base); }
  .policy-container { max-width: 820px; }
  .policy-updated { color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1.75rem; }
  .contact-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .contact-cards-grid { grid-template-columns: 1fr 1fr; }
  }
  .policy-card {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .policy-card h2 { font-size: 1.15rem; margin: 0; color: var(--text-primary); }
  .policy-card p { font-size: 0.94rem; color: var(--text-secondary); line-height: 1.65; margin: 0; }
  .policy-card a { color: var(--mn-cta); font-weight: 700; }
</style>
