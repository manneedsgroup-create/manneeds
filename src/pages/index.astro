<script>
  import { getProducts, cleanProductName } from '../lib/db';
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  const productsGrid = document.getElementById('products-grid');
  const countLabel = document.getElementById('product-count-label');
  let currentActiveCategory = 'all';

  // Helper to get category icon
  function getCategoryIcon(cat: string): string {
    if (cat.includes('Honey')) return '🍯';
    if (cat.includes('Snack')) return '🍿';
    if (cat.includes('Chip')) return '🥭';
    if (cat.includes('Cand')) return '🍬';
    return '🌿';
  }

  // Auto-scrolling Product Image Carousels (Transitions every 2.5 seconds)
  let carouselTimers: number[] = [];
  let carouselObserver: IntersectionObserver | null = null;

  function initProductCarousels() {
    // Clear any existing intervals
    carouselTimers.forEach((timer) => clearInterval(timer));
    carouselTimers = [];

    if (carouselObserver) {
      carouselObserver.disconnect();
      carouselObserver = null;
    }

    const visualCarousels = document.querySelectorAll('.product-visual[data-carousel]');
    if (!visualCarousels || visualCarousels.length === 0) return;

    const isObserverSupported = typeof window !== 'undefined' && 'IntersectionObserver' in window;

    visualCarousels.forEach((visualEl) => {
      const slides = visualEl.querySelectorAll('.carousel-slide');
      if (slides.length <= 1) return;

      const dots = visualEl.querySelectorAll('.carousel-dot');
      let currentIndex = 0;
      let timerId: number | null = null;
      let isPaused = false;

      function goToSlide(newIndex: number) {
        if (newIndex === currentIndex || newIndex < 0 || newIndex >= slides.length) return;
        slides[currentIndex]?.classList.remove('active');
        dots[currentIndex]?.classList.remove('active');

        currentIndex = newIndex;

        slides[currentIndex]?.classList.add('active');
        dots[currentIndex]?.classList.add('active');
      }

      function nextSlide() {
        if (isPaused) return;
        const nextIndex = (currentIndex + 1) % slides.length;
        goToSlide(nextIndex);
      }

      function startTimer() {
        if (timerId !== null) return;
        timerId = window.setInterval(nextSlide, 2500); // Auto-rotate every 2.5 seconds
        carouselTimers.push(timerId);
      }

      function stopTimer() {
        if (timerId !== null) {
          clearInterval(timerId);
          carouselTimers = carouselTimers.filter((t) => t !== timerId);
          timerId = null;
        }
      }

      // Manual dot navigation
      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetIdx = parseInt((dot as HTMLElement).getAttribute('data-dot-index') || '0', 10);
          goToSlide(targetIdx);
          stopTimer();
          startTimer();
        });
      });

      // Pause on hover or touch
      visualEl.addEventListener('mouseenter', () => { isPaused = true; });
      visualEl.addEventListener('mouseleave', () => { isPaused = false; });
      visualEl.addEventListener('touchstart', () => { isPaused = true; }, { passive: true });
      visualEl.addEventListener('touchend', () => {
        setTimeout(() => { isPaused = false; }, 2000);
      }, { passive: true });

      // Only run auto-scroll when visible in viewport
      if (isObserverSupported) {
        if (!carouselObserver) {
          carouselObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              const target = entry.target as HTMLElement;
              const startFn = (target as any)._startCarousel;
              const stopFn = (target as any)._stopCarousel;
              if (entry.isIntersecting) {
                if (startFn) startFn();
              } else {
                if (stopFn) stopFn();
              }
            });
          }, { threshold: 0.1 });
        }
        (visualEl as any)._startCarousel = startTimer;
        (visualEl as any)._stopCarousel = stopTimer;
        carouselObserver.observe(visualEl);
      } else {
        startTimer();
      }
    });
  }

  // --- Weight Picker Modal Logic (Quick-commerce Style) ---
  const weightModal = document.getElementById('weight-picker-modal');
  const weightModalList = document.getElementById('weight-modal-list');
  const weightModalTitle = document.getElementById('weight-modal-title');
  const weightModalCat = document.getElementById('weight-modal-category');
  const weightModalThumb = document.getElementById('weight-modal-thumb');
  const weightModalOptionsCount = document.getElementById('weight-modal-options-count');

  let activeModalCard: HTMLElement | null = null;

  function closeWeightPicker() {
    if (!weightModal) return;
    weightModal.classList.remove('open');
    weightModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    activeModalCard = null;
  }

  // Setup modal close listeners once
  document.querySelectorAll('[data-close-weight-modal]').forEach((el) => {
    el.addEventListener('click', closeWeightPicker);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && weightModal?.classList.contains('open')) {
      closeWeightPicker();
    }
  });

  function openWeightPicker(card: HTMLElement) {
    if (!weightModal || !weightModalList) return;
    activeModalCard = card;

    const id = card.getAttribute('data-product-id') || 'product';
    const name = card.getAttribute('data-product-name') || 'Product';
    const category = card.getAttribute('data-category') || '';
    const selectedWeight = card.getAttribute('data-selected-weight') || '';
    const discount = card.getAttribute('data-discount') || '20% OFF';
    const imgUrl = card.getAttribute('data-img') || card.querySelector('.product-real-img')?.getAttribute('src') || '';
    const icon = card.querySelector('.emblem-icon')?.textContent || '🌿';

    let variants: any[] = [];
    try {
      const rawVariants = card.getAttribute('data-variants');
      if (rawVariants) variants = JSON.parse(rawVariants);
    } catch {}

    if (!variants || variants.length === 0) {
      const currentPrice = card.getAttribute('data-selected-price') || '₹149';
      const origPrice = card.querySelector('[data-orig-price-target]')?.textContent || '';
      variants = [{ weight: selectedWeight || '100g', price: currentPrice, originalPrice: origPrice }];
    }

    if (weightModalTitle) weightModalTitle.textContent = name;
    if (weightModalCat) weightModalCat.textContent = category;
    if (weightModalOptionsCount) {
      weightModalOptionsCount.textContent = `${variants.length} ${variants.length === 1 ? 'pack size' : 'pack sizes'} available`;
    }

    if (weightModalThumb) {
      if (imgUrl) {
        weightModalThumb.innerHTML = `<img src="${imgUrl}" alt="${name}" class="weight-modal-thumb-img" />`;
      } else {
        weightModalThumb.innerHTML = `<span class="weight-modal-thumb-icon">${icon}</span>`;
      }
    }

    // Populate variant rows
    const cardStock = parseInt(card.querySelector('[data-stock-target]')?.textContent?.replace(/\D/g, '') || '30', 10);
    weightModalList.innerHTML = variants.map((v: any, vIdx: number) => {
      const isSelected = v.weight === selectedWeight;
      const vStock = vIdx === 0 ? cardStock : (v.stock !== undefined && v.stock !== null ? Number(v.stock) : Math.max(1, Math.floor(cardStock / 2)));
      const vOrigPrice = v.originalPrice || v.original_price || '';
      
      return `
        <div 
          class="weight-modal-row ${isSelected ? 'is-selected' : ''}" 
          data-variant-weight="${v.weight}"
          data-variant-price="${v.price}"
          data-variant-orig-price="${vOrigPrice}"
          data-variant-stock="${vStock}"
          role="button"
          tabindex="0"
        >
          <div class="weight-modal-row-left">
            <div class="weight-modal-weight-row">
              <span class="weight-modal-weight-badge">${v.weight}</span>
              ${discount ? `<span class="weight-modal-disc-tag">${discount}</span>` : ''}
              ${isSelected ? `<span class="weight-modal-cur-pill">Current</span>` : ''}
            </div>
            <div class="weight-modal-price-row">
              <span class="weight-modal-price">${v.price}</span>
              ${vOrigPrice ? `<span class="weight-modal-orig-price">${vOrigPrice}</span>` : ''}
            </div>
            <div class="weight-modal-stock ${vStock <= 10 ? 'low' : ''}">
              ${vStock <= 0 ? 'Out of stock' : vStock <= 10 ? `🔥 Only ${vStock} left` : `In Stock (${vStock} units left)`}
            </div>
          </div>
          <div class="weight-modal-row-right">
            <button 
              type="button" 
              class="weight-modal-add-btn" 
              data-modal-add-variant 
              aria-label="Add ${name} ${v.weight} to cart"
            >
              <span class="btn-label">+ ADD</span>
            </button>
          </div>
        </div>
      `;
    }).join('');

    // Attach click events on the variant rows
    weightModalList.querySelectorAll('.weight-modal-row').forEach((row) => {
      const chooseVariant = (targetBtn?: HTMLElement) => {
        const weight = row.getAttribute('data-variant-weight') || '100g';
        const price = row.getAttribute('data-variant-price') || '';
        const origPrice = row.getAttribute('data-variant-orig-price') || '';
        const stock = parseInt(row.getAttribute('data-variant-stock') || '30', 10);

        const btn = targetBtn || row.querySelector('[data-modal-add-variant]') as HTMLElement;
        if (btn) {
          btn.classList.add('added');
          btn.innerHTML = `<span>✓ Added</span>`;
        }

        // Add to cart
        if ((window as any).manneedsCart?.add) {
          (window as any).manneedsCart.add({
            id,
            name,
            weight,
            price,
            originalPrice: origPrice || undefined,
            category
          });
        }

        // Update card in page
        if (activeModalCard) {
          activeModalCard.setAttribute('data-selected-weight', weight);
          activeModalCard.setAttribute('data-selected-price', price);

          const weightDisplay = activeModalCard.querySelector('[data-weight-display]');
          if (weightDisplay) weightDisplay.textContent = weight;

          const priceEl = activeModalCard.querySelector('[data-price-target]');
          if (priceEl && price) priceEl.textContent = price;

          const origPriceEl = activeModalCard.querySelector('[data-orig-price-target]');
          if (origPriceEl) {
            if (origPrice) {
              origPriceEl.textContent = origPrice;
              (origPriceEl as HTMLElement).style.display = '';
            } else {
              (origPriceEl as HTMLElement).style.display = 'none';
            }
          }

          const stockEl = activeModalCard.querySelector('[data-stock-target]');
          if (stockEl) {
            stockEl.className = `stock-indicator ${stock <= 10 ? 'low-stock' : ''}`;
            stockEl.textContent = stock <= 0 ? 'Out of stock' : stock <= 10 ? `🔥 Only ${stock} left` : `${stock} left`;
          }

          // Update discount tag right of MRP
          const discEl = activeModalCard.querySelector('[data-discount-target]');
          if (discEl) {
            let discText = activeModalCard.getAttribute('data-discount') || '20% OFF';
            if (price && origPrice) {
              const p = parseFloat(price.replace(/[^\d.]/g, ''));
              const o = parseFloat(origPrice.replace(/[^\d.]/g, ''));
              if (o > p && o > 0) {
                const pct = Math.round(((o - p) / o) * 100);
                if (pct > 0) discText = `${pct}% OFF`;
              }
            }
            discEl.textContent = discText;
          }
        }

        setTimeout(() => {
          closeWeightPicker();
        }, 320);
      };

      row.addEventListener('click', (e) => {
        const targetBtn = (e.target as HTMLElement).closest('[data-modal-add-variant]') as HTMLElement | null;
        chooseVariant(targetBtn || undefined);
      });
    });

    weightModal.classList.add('open');
    weightModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  // Bind interactive weight selection and add-to-cart clicks
  function bindProductInteractions() {
    if (!productsGrid) return;

    // Pack size selector click on cards opens popup
    productsGrid.querySelectorAll('[data-open-weight-picker]').forEach((trigger) => {
      trigger.replaceWith(trigger.cloneNode(true));
    });
    productsGrid.querySelectorAll('[data-open-weight-picker]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = (e.currentTarget as HTMLElement).closest('.product-card') as HTMLElement;
        if (card) openWeightPicker(card);
      });
    });

    // Add to cart buttons
    productsGrid.querySelectorAll('[data-cart-action]').forEach((btn) => {
      btn.replaceWith(btn.cloneNode(true));
    });

    productsGrid.querySelectorAll('[data-cart-action]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const card = (e.currentTarget as HTMLElement).closest('.product-card') as HTMLElement;
        if (!card) return;

        let variants: any[] = [];
        try {
          const raw = card.getAttribute('data-variants');
          if (raw) variants = JSON.parse(raw);
        } catch {}

        // If product has multiple variants, open weight picker popup!
        if (variants && variants.length > 1) {
          openWeightPicker(card);
          return;
        }

        // If single variant or none, add directly to cart
        const id = card.getAttribute('data-product-id') || 'product';
        const name = card.getAttribute('data-product-name') || 'Product';
        const weight = card.getAttribute('data-selected-weight') || '100g';
        const price = card.getAttribute('data-selected-price') || '';
        const originalPrice = card.querySelector('[data-orig-price-target]')?.textContent || undefined;
        const category = card.getAttribute('data-category') || '';

        if ((window as any).manneedsCart?.add) {
          (window as any).manneedsCart.add({
            id,
            name,
            weight,
            price,
            originalPrice,
            category
          });
        }
      });
    });
  }

  // Filter products by category & live search query
  let currentSearchQuery = '';
  const catalogSearchInput = document.getElementById('catalog-search-input') as HTMLInputElement | null;
  const catalogSearchClear = document.getElementById('catalog-search-clear') as HTMLButtonElement | null;
  const emptyState = document.getElementById('no-products-found');
  const emptyStateQueryText = document.getElementById('no-products-query-text');
  const resetFiltersBtn = document.getElementById('reset-filters-btn');

  function applyFilters() {
    if (!productsGrid) return;

    const cards = productsGrid.querySelectorAll('.product-card');
    let visibleCount = 0;
    const q = currentSearchQuery.toLowerCase().trim();

    cards.forEach((card) => {
      const cardCat = (card.getAttribute('data-category') || '').trim();
      const cardName = (card.getAttribute('data-product-name') || '').toLowerCase();
      const cardDesc = (card.querySelector('.product-desc')?.textContent || '').toLowerCase();
      const cardFlavour = (card.querySelector('.flavour-tag strong')?.textContent || '').toLowerCase();
      const cardWeight = (card.getAttribute('data-selected-weight') || '').toLowerCase();

      // Check category
      let matchesCat = false;
      if (currentActiveCategory === 'all') {
        matchesCat = true;
      } else if (currentActiveCategory === 'Herbal & Superfood Powders') {
        matchesCat = cardCat === 'Herbal & Superfood Powders' || cardCat.includes('Powder');
      } else if (currentActiveCategory === 'Healthy Snacks') {
        matchesCat = cardCat === 'Healthy Snacks' || cardCat.includes('Snack');
      } else if (currentActiveCategory === 'Real Fruit Candies') {
        matchesCat = cardCat === 'Real Fruit Candies' || cardCat.includes('Cand');
      } else if (currentActiveCategory === 'Dried Fruit Chips') {
        matchesCat = cardCat === 'Dried Fruit Chips' || cardCat.includes('Chip');
      } else if (currentActiveCategory === 'Raw Honey & Pure Elixirs') {
        matchesCat = cardCat === 'Raw Honey & Pure Elixirs' || cardCat.includes('Honey') || cardCat.includes('Elixir');
      } else {
        matchesCat = cardCat.toLowerCase().includes(currentActiveCategory.toLowerCase());
      }

      // Check search
      let matchesSearch = true;
      if (q) {
        matchesSearch = cardName.includes(q) ||
          cardDesc.includes(q) ||
          cardFlavour.includes(q) ||
          cardCat.toLowerCase().includes(q) ||
          cardWeight.includes(q);
      }

      const isVisible = matchesCat && matchesSearch;
      const cardEl = card as HTMLElement;
      if (isVisible) {
        cardEl.style.display = '';
        cardEl.classList.remove('hidden-category');
        visibleCount++;
      } else {
        cardEl.style.display = 'none';
        cardEl.classList.add('hidden-category');
      }
    });

    if (countLabel) {
      countLabel.textContent = `${visibleCount} Products Available`;
    }

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.style.display = 'flex';
        if (emptyStateQueryText) {
          emptyStateQueryText.textContent = q
            ? `No products found matching "${currentSearchQuery}". Try clearing search or selecting All Products.`
            : `No products currently available in this category.`;
        }
      } else {
        emptyState.style.display = 'none';
      }
    }
  }

  // Backward-compatible category filter helper
  function applyCategoryFilter(cat: string) {
    currentActiveCategory = cat;
    applyFilters();
  }
  (window as any).applyCategoryFilter = applyCategoryFilter;

  // Setup category filter tabs
  const filterButtons = document.querySelectorAll('.cat-filter-btn');
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget as HTMLElement;
      filterButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      targetBtn.classList.add('active');
      targetBtn.setAttribute('aria-selected', 'true');

      const cat = targetBtn.getAttribute('data-cat') || 'all';
      currentActiveCategory = cat;
      applyFilters();
    });
  });

  // Setup live search input & clear
  if (catalogSearchInput) {
    catalogSearchInput.addEventListener('input', () => {
      currentSearchQuery = catalogSearchInput.value;
      if (catalogSearchClear) {
        catalogSearchClear.style.display = currentSearchQuery ? 'flex' : 'none';
      }
      applyFilters();
    });
  }

  if (catalogSearchClear) {
    catalogSearchClear.addEventListener('click', () => {
      currentSearchQuery = '';
      if (catalogSearchInput) catalogSearchInput.value = '';
      catalogSearchClear.style.display = 'none';
      applyFilters();
      catalogSearchInput?.focus();
    });
  }

  // Reset filters button in empty state
  if (resetFiltersBtn) {
    resetFiltersBtn.addEventListener('click', () => {
      currentActiveCategory = 'all';
      currentSearchQuery = '';
      if (catalogSearchInput) catalogSearchInput.value = '';
      if (catalogSearchClear) catalogSearchClear.style.display = 'none';
      filterButtons.forEach((b) => {
        const isAll = b.getAttribute('data-cat') === 'all';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-selected', String(isAll));
      });
      applyFilters();
    });
  }

  // Listen for search dispatched from top header navbar
  window.addEventListener('manneeds-search', (e: any) => {
    const q = e.detail?.query || '';
    currentSearchQuery = q;
    if (catalogSearchInput) {
      catalogSearchInput.value = q;
      if (catalogSearchClear) {
        catalogSearchClear.style.display = q ? 'flex' : 'none';
      }
    }
    applyFilters();
  });

  // Also hook up category showcase cards to filter
  document.querySelectorAll('.category-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const title = card.querySelector('.cat-title')?.textContent || '';
      let targetCat = 'all';
      if (title.includes('Powder')) targetCat = 'Herbal & Superfood Powders';
      else if (title.includes('Snack')) targetCat = 'Healthy Snacks';
      else if (title.includes('Cand')) targetCat = 'Real Fruit Candies';
      else if (title.includes('Chip')) targetCat = 'Dried Fruit Chips';
      else if (title.includes('Honey')) targetCat = 'Raw Honey & Pure Elixirs';

      filterButtons.forEach((b) => {
        const matches = b.getAttribute('data-cat') === targetCat;
        b.classList.toggle('active', matches);
        b.setAttribute('aria-selected', String(matches));
      });

      currentActiveCategory = targetCat;
      applyFilters();
      document.getElementById('bestsellers')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Render products when updated dynamically from Supabase
  function renderProducts(items: any[]) {
    if (!productsGrid || !items || items.length === 0) return;

    productsGrid.innerHTML = items.map((item) => {
      const masterStock = item.stockQuantity !== undefined && item.stockQuantity !== null
        ? Number(item.stockQuantity)
        : (item.stock_quantity !== undefined && item.stock_quantity !== null ? Number(item.stock_quantity) : 0);

      const variants = item.variants && item.variants.length > 0 ? item.variants : [
        { weight: '100g', price: item.price, originalPrice: item.originalPrice, stock: masterStock },
        { weight: '200g', price: item.price, originalPrice: item.originalPrice, stock: Math.max(1, Math.floor(masterStock / 2)) }
      ];

      const defaultVariant = variants[0];
      const currentPrice = defaultVariant ? defaultVariant.price : item.price;
      const originalPrice = defaultVariant ? (defaultVariant.originalPrice || defaultVariant.original_price || item.originalPrice) : item.originalPrice;
      const currentStock = masterStock;
      const currentWeight = defaultVariant ? defaultVariant.weight : '100g';
      const icon = getCategoryIcon(item.category || '');
      const itemImages: string[] = item.images && Array.isArray(item.images) && item.images.length > 0
        ? item.images
        : (item.image || item.imageUrl ? [item.image || item.imageUrl] : []);

      return `
        <div 
          class="mn-card product-card"
          data-product-id="${item.id}"
          data-category="${item.category}"
          data-product-name="${cleanProductName(item.name).replace(/"/g, '&quot;')}"
          data-selected-weight="${currentWeight}"
          data-selected-price="${currentPrice}"
          data-variants="${JSON.stringify(variants).replace(/"/g, '&quot;')}"
          data-img="${itemImages[0] || ''}"
          data-discount="${item.discount || '20% OFF'}"
        >
          <div class="product-visual" data-carousel>
            ${item.badge ? `
              <div class="product-visual-badges">
                <span class="badge-corner" title="${item.badge}">${item.badge}</span>
              </div>
            ` : ''}
            <div class="product-illustration">
              <div class="product-carousel-track" data-carousel-track>
                ${itemImages.length > 0 ? itemImages.map((imgUrl: string, imgIdx: number) => `
                  <div class="carousel-slide ${imgIdx === 0 ? 'active' : ''}" data-slide-index="${imgIdx}">
                    <img src="${imgUrl}" alt="${cleanProductName(item.name).replace(/"/g, '&quot;')} photo ${imgIdx + 1}" class="product-real-img" loading="${imgIdx === 0 ? 'eager' : 'lazy'}" />
                  </div>
                `).join('') : `
                  <div class="food-pack-emblem">
                    <span class="emblem-icon">${icon}</span>
                    <span class="emblem-label">${(item.category || '').includes('Honey') ? 'RAW HONEY' : (item.category || '').includes('Snack') ? 'ROASTED' : (item.category || '').includes('Chip') ? 'CRISP' : (item.category || '').includes('Cand') ? 'REAL FRUIT' : 'BOTANICAL'}</span>
                  </div>
                `}
              </div>
            </div>
            ${itemImages.length > 1 ? `
              <div class="carousel-dots" data-carousel-dots aria-label="Image indicators">
                ${itemImages.map((_: any, dotIdx: number) => `
                  <button type="button" class="carousel-dot ${dotIdx === 0 ? 'active' : ''}" data-dot-index="${dotIdx}" aria-label="Show image ${dotIdx + 1}"></button>
                `).join('')}
              </div>
            ` : ''}
            <div class="flavour-tag">
              <span>Variant: <strong>${item.flavour || 'Natural Harvest'}</strong></span>
            </div>
          </div>
          <div class="product-content">
            <div class="product-header-meta">
              <span class="product-cat-name" title="${item.category || ''}">${item.category}</span>
              <span class="stock-indicator ${currentStock <= 10 ? 'low-stock' : ''}" data-stock-target>
                ${currentStock <= 0 ? 'Out of stock' : currentStock <= 10 ? `🔥 Only ${currentStock} left` : `${currentStock} left`}
              </span>
            </div>
            <h3 class="product-name" title="${cleanProductName(item.name)}">${cleanProductName(item.name)}</h3>
            <div class="product-rating" aria-label="Rated ${item.rating || 4.8} out of 5 stars with ${item.reviews || '250+'} reviews">
              <span class="rating-star">★</span>
              <span class="rating-score">${item.rating || 4.8}</span>
              <span class="rating-count">(${item.reviews || '250+'})</span>
            </div>
            <p class="product-desc">${item.desc || item.description || ''}</p>

            ${variants && variants.length > 0 ? `
              <div 
                class="pack-size-selector" 
                data-open-weight-picker 
                role="button" 
                tabindex="0" 
                aria-label="Select pack size"
                title="Click to view all pack sizes"
              >
                <span class="pack-size-val" data-weight-display>${currentWeight}</span>
                ${variants.length > 1 ? `
                  <span class="pack-size-arrow">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    <span class="pack-size-count">${variants.length} sizes</span>
                  </span>
                ` : ''}
              </div>
            ` : ''}

            <div class="product-price-row">
              <div class="price-wrap">
                <span class="current-price" data-price-target>${currentPrice}</span>
                ${originalPrice ? `<span class="original-price" data-orig-price-target>${originalPrice}</span>` : ''}
                <span class="discount-tag" data-discount-target>${item.discount || '20% OFF'}</span>
              </div>
            </div>

            <button 
              type="button" 
              class="btn btn-primary add-to-cart-btn"
              data-cart-action
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span>Add To Cart</span>
              ${variants.length > 1 ? `<span class="btn-chevron">▾</span>` : ''}
            </button>
          </div>
        </div>
      `;
    }).join('');

    bindProductInteractions();
    initProductCarousels();
    applyFilters();
  }

  // Initialize interactive handlers on server-rendered cards
  bindProductInteractions();
  initProductCarousels();

  // Live Auto-Sync with Supabase
  if (isSupabaseConfigured) {
    // Check if live products on page load have any difference before updating DOM
    getProducts().then((latest) => {
      if (latest && latest.length > 0) {
        const existingCards = productsGrid?.querySelectorAll('.product-card');
        if (!existingCards || existingCards.length !== latest.length) {
          renderProducts(latest);
        } else {
          // Just update stock / prices in place without re-rendering entire grid
          latest.forEach((p) => {
            const card = productsGrid?.querySelector(`[data-product-id="${p.id}"]`);
            if (card) {
              const stockEl = card.querySelector('[data-stock-target]');
              const masterStock = p.stockQuantity ?? 0;
              if (stockEl) {
                stockEl.className = `stock-indicator ${masterStock <= 10 ? 'low-stock' : ''}`;
                stockEl.textContent = masterStock <= 0 ? 'Out of stock' : masterStock <= 10 ? `🔥 Only ${masterStock} left` : `${masterStock} left`;
              }
            }
          });
        }
      }
    });

    // Realtime subscription: updates DOM automatically when any row in Supabase changes
    supabase
      .channel('realtime:products')
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'products' }, (payload: any) => {
        const row = payload.new;
        if (!row || !row.id) return;
        const card = productsGrid?.querySelector(`[data-product-id="${row.id}"]`);
        if (card) {
          const masterStock = row.stock_quantity !== undefined && row.stock_quantity !== null
            ? Number(row.stock_quantity)
            : Number(row.stock || 0);

          // Update stock indicator
          const stockEl = card.querySelector('[data-stock-target]');
          if (stockEl) {
            stockEl.className = `stock-indicator ${masterStock <= 10 ? 'low-stock' : ''}`;
            stockEl.textContent = masterStock <= 0 ? 'Out of stock' : masterStock <= 10 ? `🔥 Only ${masterStock} left` : `${masterStock} left`;
          }

          // Update variants stock data on card
          try {
            const rawVars = card.getAttribute('data-variants');
            if (rawVars) {
              const vars = JSON.parse(rawVars);
              if (vars && vars[0]) {
                vars[0].stock = masterStock;
                card.setAttribute('data-variants', JSON.stringify(vars));
              }
            }
          } catch {}
        } else {
          getProducts().then((refreshed) => renderProducts(refreshed));
        }
      })
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'products' }, async () => {
        const refreshed = await getProducts();
        renderProducts(refreshed);
      })
      .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'products' }, async () => {
        const refreshed = await getProducts();
        renderProducts(refreshed);
      })
      .subscribe();
  }
</script>

