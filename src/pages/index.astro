<script>
  import { getProducts, saveQuizLead } from '../lib/db';
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  const productsGrid = document.getElementById('products-grid');
  const countLabel = document.getElementById('product-count-label');
  let currentActiveCategory = 'all';

  // Helper to get category icon
  function getCategoryIcon(cat: string): string {
    if (cat.includes('Honey')) return '🍯';
    if (cat.includes('Snack')) return '🍿';
    if (cat.includes('Chip')) return '🥭';
    if (cat.includes('Cand')) return '🍬';
    return '🌿';
  }

  // Bind interactive weight selection and add-to-cart clicks
  function bindProductInteractions() {
    if (!productsGrid) return;

    // Weight variant pill buttons
    const weightPills = productsGrid.querySelectorAll('.weight-pill');
    weightPills.forEach((pill) => {
      // Remove any existing listener by replacing or checking dataset
      pill.replaceWith(pill.cloneNode(true));
    });

    productsGrid.querySelectorAll('.weight-pill').forEach((pill) => {
      pill.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLElement;
        const card = btn.closest('.product-card') as HTMLElement;
        if (!card) return;

        // Toggle active pill in this card
        const group = btn.closest('.weight-pill-group');
        group?.querySelectorAll('.weight-pill').forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');

        const weight = btn.getAttribute('data-weight') || '100g';
        const price = btn.getAttribute('data-price') || '';
        const origPrice = btn.getAttribute('data-orig-price') || '';
        const stock = parseInt(btn.getAttribute('data-stock') || '0', 10);

        // Update card data attributes
        card.setAttribute('data-selected-weight', weight);
        card.setAttribute('data-selected-price', price);

        // Update weight display badge
        const weightDisplay = card.querySelector('[data-weight-display]');
        if (weightDisplay) weightDisplay.textContent = weight;

        // Update price display
        const priceEl = card.querySelector('[data-price-target]');
        if (priceEl && price) priceEl.textContent = price;

        // Update original price
        const origPriceEl = card.querySelector('[data-orig-price-target]');
        if (origPriceEl) {
          if (origPrice) {
            origPriceEl.textContent = origPrice;
            (origPriceEl as HTMLElement).style.display = '';
          } else {
            (origPriceEl as HTMLElement).style.display = 'none';
          }
        }

        // Update stock indicator
        const stockEl = card.querySelector('[data-stock-target]');
        if (stockEl) {
          stockEl.className = `stock-indicator ${stock <= 10 ? 'low-stock' : ''}`;
          stockEl.textContent = stock <= 0 ? '❌ Out of Stock' : stock <= 10 ? `🔥 Only ${stock} Left` : `✓ Stock: ${stock}`;
        }
      });
    });

    // Add to cart buttons
    productsGrid.querySelectorAll('[data-cart-action]').forEach((btn) => {
      btn.replaceWith(btn.cloneNode(true));
    });

    productsGrid.querySelectorAll('[data-cart-action]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const card = (e.currentTarget as HTMLElement).closest('.product-card');
        if (!card) return;
        const name = card.getAttribute('data-product-name') || 'Product';
        const weight = card.getAttribute('data-selected-weight') || '100g';
        const price = card.getAttribute('data-selected-price') || '';
        alert(`Added ${name} (${weight}) - ${price} to your ManNeeds cart!\nUse coupon code MANNEEDS15 for 15% off.`);
      });
    });
  }

  // Filter products by category
  function applyCategoryFilter(cat: string) {
    currentActiveCategory = cat;
    if (!productsGrid) return;

    const cards = productsGrid.querySelectorAll('.product-card');
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCat = (card.getAttribute('data-category') || '').trim();
      let isVisible = false;

      if (cat === 'all') {
        isVisible = true;
      } else if (cat === 'Herbal & Superfood Powders') {
        isVisible = cardCat === 'Herbal & Superfood Powders' || cardCat.includes('Powder');
      } else if (cat === 'Healthy Snacks') {
        isVisible = cardCat === 'Healthy Snacks' || cardCat.includes('Snack');
      } else if (cat === 'Real Fruit Candies') {
        isVisible = cardCat === 'Real Fruit Candies' || cardCat.includes('Cand');
      } else if (cat === 'Dried Fruit Chips') {
        isVisible = cardCat === 'Dried Fruit Chips' || cardCat.includes('Chip');
      } else if (cat === 'Raw Honey & Pure Elixirs') {
        isVisible = cardCat === 'Raw Honey & Pure Elixirs' || cardCat.includes('Honey') || cardCat.includes('Elixir');
      } else {
        isVisible = cardCat.toLowerCase().includes(cat.toLowerCase());
      }

      const cardEl = card as HTMLElement;
      if (isVisible) {
        cardEl.style.display = '';
        cardEl.classList.remove('hidden-category');
        visibleCount++;
      } else {
        cardEl.style.display = 'none';
        cardEl.classList.add('hidden-category');
      }
    });

    if (countLabel) {
      countLabel.textContent = `${visibleCount} Products Available`;
    }
  }

  // Setup category filter tabs
  const filterButtons = document.querySelectorAll('.cat-filter-btn');
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget as HTMLElement;
      filterButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      targetBtn.classList.add('active');
      targetBtn.setAttribute('aria-selected', 'true');

      const cat = targetBtn.getAttribute('data-cat') || 'all';
      applyCategoryFilter(cat);
    });
  });

  // Also hook up category showcase cards to filter
  document.querySelectorAll('.category-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const title = card.querySelector('.cat-title')?.textContent || '';
      let targetCat = 'all';
      if (title.includes('Powder')) targetCat = 'Herbal & Superfood Powders';
      else if (title.includes('Snack')) targetCat = 'Healthy Snacks';
      else if (title.includes('Cand')) targetCat = 'Real Fruit Candies';
      else if (title.includes('Chip')) targetCat = 'Dried Fruit Chips';
      else if (title.includes('Honey')) targetCat = 'Raw Honey & Pure Elixirs';

      filterButtons.forEach((b) => {
        const matches = b.getAttribute('data-cat') === targetCat;
        b.classList.toggle('active', matches);
        b.setAttribute('aria-selected', String(matches));
      });

      applyCategoryFilter(targetCat);
      document.getElementById('bestsellers')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Render products when updated dynamically from Supabase
  function renderProducts(items: any[]) {
    if (!productsGrid || !items || items.length === 0) return;

    productsGrid.innerHTML = items.map((item) => {
      const masterStock = item.stockQuantity !== undefined && item.stockQuantity !== null
        ? Number(item.stockQuantity)
        : (item.stock_quantity !== undefined && item.stock_quantity !== null ? Number(item.stock_quantity) : 0);

      const variants = item.variants && item.variants.length > 0 ? item.variants : [
        { weight: '100g', price: item.price, originalPrice: item.originalPrice, stock: masterStock },
        { weight: '200g', price: item.price, originalPrice: item.originalPrice, stock: Math.max(1, Math.floor(masterStock / 2)) }
      ];

      const defaultVariant = variants[0];
      const currentPrice = defaultVariant ? defaultVariant.price : item.price;
      const originalPrice = defaultVariant ? (defaultVariant.originalPrice || defaultVariant.original_price || item.originalPrice) : item.originalPrice;
      const currentStock = masterStock;
      const currentWeight = defaultVariant ? defaultVariant.weight : '100g';
      const icon = getCategoryIcon(item.category || '');

      return `
        <div 
          class="mn-card product-card"
          data-product-id="${item.id}"
          data-category="${item.category}"
          data-product-name="${item.name.replace(/"/g, '&quot;')}"
          data-selected-weight="${currentWeight}"
          data-selected-price="${currentPrice}"
        >
          <div class="product-visual">
            <span class="discount-badge">${item.discount || '20% OFF'}</span>
            <span class="badge-corner">${item.badge || 'Pure Plant'}</span>
            <div class="product-illustration">
              <div class="bottle-mockup">
                <span class="mockup-leaf">${icon}</span>
                <div class="mockup-bubble b1"></div>
                <div class="mockup-bubble b2"></div>
              </div>
            </div>
            <div class="flavour-tag">
              <span>Flavour: <strong>${item.flavour || 'Natural'}</strong></span>
            </div>
          </div>
          <div class="product-content">
            <div class="product-header-meta">
              <span class="product-cat-name">${item.category}</span>
              <span class="stock-indicator ${currentStock <= 10 ? 'low-stock' : ''}" data-stock-target>
                ${currentStock <= 0 ? '❌ Out of Stock' : currentStock <= 10 ? `🔥 Only ${currentStock} Left` : `✓ Stock: ${currentStock}`}
              </span>
            </div>
            <h3 class="product-name">${item.name}</h3>
            <p class="product-desc">${item.desc || item.description || ''}</p>

            <div class="weight-variants-box">
              <div class="variants-header-line">
                <span class="weight-variants-label">Select Pack Size:</span>
                <span class="weight-selected-badge" data-weight-display>${currentWeight}</span>
              </div>
              <div class="weight-pill-group">
                ${variants.map((v: any, vIdx: number) => {
                  const variantStock = vIdx === 0 ? masterStock : (v.stock !== undefined && v.stock !== null ? Number(v.stock) : Math.max(1, Math.floor(masterStock / 2)));
                  return `
                    <button
                      type="button"
                      class="weight-pill ${vIdx === 0 ? 'active' : ''}"
                      data-weight="${v.weight}"
                      data-price="${v.price}"
                      data-orig-price="${v.originalPrice || v.original_price || ''}"
                      data-stock="${variantStock}"
                      aria-label="Select ${v.weight} pack"
                    >
                      <span class="pill-weight">${v.weight}</span>
                    </button>
                  `;
                }).join('')}
              </div>
            </div>

            <div class="product-price-row">
              <div class="price-wrap">
                <span class="current-price" data-price-target>${currentPrice}</span>
                ${originalPrice ? `<span class="original-price" data-orig-price-target>${originalPrice}</span>` : ''}
              </div>
              <span class="save-tag">${item.discount || 'SAVE 20%'}</span>
            </div>

            <button 
              type="button" 
              class="btn btn-primary add-to-cart-btn"
              data-cart-action
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span>Add To Cart</span>
            </button>
          </div>
        </div>
      `;
    }).join('');

    bindProductInteractions();
    applyCategoryFilter(currentActiveCategory);
  }

  // Initialize interactive handlers on server-rendered cards
  bindProductInteractions();

  // Live Auto-Sync with Supabase
  if (isSupabaseConfigured) {
    // Fetch live products on page load
    getProducts().then((latest) => {
      if (latest && latest.length > 0) renderProducts(latest);
    });

    // Realtime subscription: updates DOM automatically when any row in Supabase changes
    supabase
      .channel('realtime:products')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'products' }, async () => {
        const refreshed = await getProducts();
        renderProducts(refreshed);
      })
      .subscribe();
  }

  const intro = document.getElementById('quiz-intro');
  const openBtn = document.getElementById('open-quiz-btn');
  const formWrap = document.getElementById('quiz-form-wrap');
  const form = document.getElementById('routine-quiz-form') as HTMLFormElement;
  const cancelBtn = document.getElementById('cancel-quiz-btn');
  const submitBtn = document.getElementById('submit-quiz-btn') as HTMLButtonElement;
  const resultWrap = document.getElementById('quiz-result-wrap');
  const recTitle = document.getElementById('recommendation-title');
  const recDesc = document.getElementById('recommendation-desc');
  const retakeBtn = document.getElementById('retake-quiz-btn');

  // Open Quiz
  if (openBtn && intro && formWrap) {
    openBtn.addEventListener('click', () => {
      intro.style.display = 'none';
      formWrap.style.display = 'block';
    });
  }

  // Cancel Quiz
  if (cancelBtn && intro && formWrap) {
    cancelBtn.addEventListener('click', () => {
      formWrap.style.display = 'none';
      intro.style.display = 'block';
    });
  }

  // Submit Quiz to Supabase
  if (form && submitBtn && recTitle && recDesc && resultWrap && formWrap) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const concern = (document.getElementById('quiz-concern') as HTMLSelectElement).value;
      const format = (document.getElementById('quiz-format') as HTMLSelectElement).value;
      const email = (document.getElementById('quiz-email') as HTMLInputElement).value.trim();

      const originalBtnText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Generating Routine...';

      let recommendation = 'ManNeeds Daily Multivitamin & Debloat Fizz';
      let details = 'A synergistic plant-based daily routine designed to optimize your energy and vitality.';

      if (concern.includes('Hair Fall')) {
        recommendation = 'ManNeeds Rosemary Advanced Hair Growth Serum + Biotin Boost';
        details = 'Powered by 3% Redensyl and Baicapil to nourish follicles and reduce hair fall in 60-90 days.';
      } else if (concern.includes('Skin')) {
        recommendation = 'ManNeeds Glutathione Glow Effervescent + Vitamin C';
        details = '500mg clinical-grade L-Glutathione to reduce hyperpigmentation and promote a radiant skin tone.';
      } else if (concern.includes('Gut') || concern.includes('Weight')) {
        recommendation = 'ManNeeds Apple Cider Vinegar Daily Fizz (With Mother)';
        details = 'Pure Himalayan ACV with Pomegranate extract for healthy gut biome, digestion, and metabolism.';
      } else if (concern.includes('Debloat')) {
        recommendation = 'ManNeeds Super Greens & Debloat Effervescent';
        details = '35+ alkalising superfoods and digestive enzymes to instantly relieve bloating and acidity.';
      } else if (concern.includes('Protein')) {
        recommendation = 'ManNeeds 100% Plant Protein Powder (Rich Belgian Chocolate)';
        details = '25g complete amino-acid profile pea & brown rice protein with enzymes for easy digestion and zero bloating.';
      }

      // Save lead directly to Supabase
      await saveQuizLead({
        email,
        concern,
        preferred_format: format,
        recommendation
      });

      recTitle.textContent = recommendation;
      recDesc.textContent = details;

      formWrap.style.display = 'none';
      resultWrap.style.display = 'block';

      submitBtn.disabled = false;
      submitBtn.textContent = originalBtnText || 'Get My Routine';
    });
  }

  // Retake Quiz
  if (retakeBtn && resultWrap && intro) {
    retakeBtn.addEventListener('click', () => {
      resultWrap.style.display = 'none';
      intro.style.display = 'block';
    });
  }
</script>
