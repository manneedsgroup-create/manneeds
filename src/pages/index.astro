---
import MainLayout from '../layouts/MainLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { getProducts, cleanProductName, getReviews, getReels, getReelEmbedInfo, type Review, type ProductReel } from '../lib/db';

// Helper to scan each product folder for user-uploaded images and videos
function getLocalMedia(folder?: string): { images: string[]; videos: string[] } {
  if (!folder) return { images: [], videos: [] };
  const baseDir = path.resolve('./public/images/products', folder);
  const images: string[] = [];
  const videos: string[] = [];

  const imageExts = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif', '.gif', '.svg']);
  const videoExts = new Set(['.mp4', '.webm', '.ogg', '.mov']);

  function scan(dir: string, urlPrefix: string) {
    if (!fs.existsSync(dir)) return;
    try {
      const entries = fs.readdirSync(dir, { withFileTypes: true });
      for (const entry of entries) {
        if (entry.isFile() && !entry.name.startsWith('.')) {
          const ext = path.extname(entry.name).toLowerCase();
          if (imageExts.has(ext)) {
            images.push(`${urlPrefix}/${entry.name}`);
          } else if (videoExts.has(ext)) {
            videos.push(`${urlPrefix}/${entry.name}`);
          }
        }
      }
    } catch {}
  }

  scan(baseDir, `/images/products/${folder}`);
  scan(path.join(baseDir, 'images'), `/images/products/${folder}/images`);
  scan(path.join(baseDir, 'videos'), `/images/products/${folder}/videos`);

  return { images, videos };
}

// Fetch dynamically from Supabase database with automatic fallback
const rawBestsellers = await getProducts();
const bestsellers = rawBestsellers.map((item) => {
  const localMedia = getLocalMedia(item.folder);
  const resolvedImages = (item.images && item.images.length > 0)
    ? item.images
    : localMedia.images;
  const resolvedVideos = (item.videos && item.videos.length > 0)
    ? item.videos
    : localMedia.videos;

  return {
    ...item,
    image: resolvedImages[0] || item.image || item.imageUrl || '',
    images: resolvedImages,
    videos: resolvedVideos
  };
});
// Fetch verified customer reviews from Supabase (never fake/hardcoded)
const initialReviews: Review[] = await getReviews(12);
const reviewCount = initialReviews.length;
const avgRating = reviewCount > 0
  ? (initialReviews.reduce((acc, r) => acc + (Number(r.rating) || 5), 0) / reviewCount).toFixed(1)
  : null;

// Fetch promotional & product reels from Supabase
const initialReels: ProductReel[] = await getReels(8);
