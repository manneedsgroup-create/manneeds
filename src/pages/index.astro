---
import MainLayout from '../layouts/MainLayout.astro';

import { getProducts } from '../lib/db';
import { isSupabaseConfigured } from '../lib/supabase';

const categories = [
  {
    id: 'Herbal & Superfood Powders',
    title: 'Botanical & Herbal Powders',
    subtitle: 'Moringa, Kulekhara, Okra, Chalta, Amla, Thankuni, Lemon & Protein',
    tag: 'Ayurvedic Actives',
    icon: '🌿',
    color: '#059669',
    bg: '#ECFDF5',
    itemsCount: '11 Powders'
  },
  {
    id: 'Healthy Snacks',
    title: 'Healthy Roasted Snacks',
    subtitle: 'Crunchy roasted wholesome munchies in Peri Peri, Chat Masala & Salted',
    tag: 'Guilt-Free',
    icon: '🍿',
    color: '#FF6838',
    bg: '#FFF7ED',
    itemsCount: '3 Products'
  },
  {
    id: 'Real Fruit Candies',
    title: 'Real Fruit Candies',
    subtitle: 'Chewy bite-sized treats made from Mango, Jackfruit, Pumpkin & Banana',
    tag: '100% Real Pulp',
    icon: '🍬',
    color: '#EC4899',
    bg: '#FDF2F8',
    itemsCount: '4 Products'
  },
  {
    id: 'Dried Fruit Chips',
    title: 'Dried Fruit Chips',
    subtitle: '100% natural vacuum-crisped Mango, Jackfruit & Banana slices',
    tag: 'Zero Palm Oil',
    icon: '🥭',
    color: '#F59E0B',
    bg: '#FEF3C7',
    itemsCount: '3 Products'
  },
  {
    id: 'Raw Honey & Pure Elixirs',
    title: 'Raw Honey & Pure Elixirs',
    subtitle: 'Unpasteurized 100% pure wild forest floral honey rich in natural live enzymes',
    tag: '100% Pure Raw',
    icon: '🍯',
    color: '#D97706',
    bg: '#FEF9C3',
    itemsCount: '1 Pure Elixir'
  }
];

// Fetch dynamically from Supabase database with automatic fallback
const bestsellers = await getProducts();
---

<MainLayout title="ManNeeds — Clean Plant Nutrition, Grooming & Daily Essentials">
  <!-- Hero Section -->
  <section class="hero-section" id="hero">
    <div class="container hero-container">
      <div class="hero-content">
        <!-- Floating Pill Badge -->
        <div class="badge badge-orange hero-badge">
          <span class="badge-dot"></span>
          2M+ Sips Enjoyed Nationwide • 100% Clean Vegan
        </div>
        
        <h1 class="hero-title">
          TAKE CARE, <br />
          <span class="text-gradient-orange">HAVE FUN!</span>
        </h1>
        
        <p class="hero-tagline-sub">
          POP. DROP. <span class="text-gradient-green">FIZZ.</span> SCORE.
        </p>

        <p class="hero-description">
          Say goodbye to bitter pills and boring diet powders! Discover clinically proven plant nutrition, hair science, and glowing skincare that tastes wildly delicious.
        </p>

        <!-- CTA Action Buttons -->
        <div class="hero-actions">
          <a href="#bestsellers" class="btn btn-primary hero-btn-main">
            <span>Shop Bestsellers (Flat 15% Off)</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="#quiz" class="btn btn-secondary hero-btn-quiz">
            <span>🌿 Take Free 60s Routine Quiz</span>
          </a>
        </div>

        <!-- 3-Step Pop Drop Fizz Interactive Bar -->
        <div class="fizz-steps-card">
          <div class="fizz-step-header">
            <span class="badge badge-green">The ManNeeds Ritual</span>
            <span class="fizz-step-title">How Drop & Fizz Magic Works in 30 Seconds:</span>
          </div>

          <div class="fizz-steps-grid">
            <div class="fizz-step-item">
              <div class="step-circle bg-orange">1</div>
              <div>
                <strong>DROP</strong>
                <span>1 effervescent tablet in 200ml cold water</span>
              </div>
            </div>
            <div class="step-arrow">→</div>
            <div class="fizz-step-item">
              <div class="step-circle bg-green">2</div>
              <div>
                <strong>FIZZ</strong>
                <span>Watch the bubbly fruit essence dissolve</span>
              </div>
            </div>
            <div class="step-arrow">→</div>
            <div class="fizz-step-item">
              <div class="step-circle bg-berry">3</div>
              <div>
                <strong>SIP & THRIVE</strong>
                <span>Drink your way to glowing health!</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="section" id="categories">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-orange">The Daily Fix Formats</span>
        <h2 class="section-title">Clean Plant Solutions Tailored For You</h2>
        <p class="section-subtitle">
          Whether you want rapid hair growth, radiant skin, or guilt-free gut detox, find your perfect plant match.
        </p>
      </div>

      <div class="categories-grid">
        {categories.map((cat) => (
          <div class="mn-card category-card" style={`background-color: ${cat.bg}; border-color: ${cat.color}25;`}>
            <div class="cat-top">
              <span class="cat-icon-symbol">{cat.icon}</span>
              <span class="cat-tag-badge" style={`color: ${cat.color}; background: #FFFFFF;`}>{cat.tag}</span>
            </div>
            <div class="cat-body">
              <h3 class="cat-title" style={`color: #111827;`}>{cat.title}</h3>
              <p class="cat-desc">{cat.subtitle}</p>
            </div>
            <div class="cat-footer">
              <span class="cat-count">{cat.itemsCount}</span>
              <span class="cat-cta-link" style={`color: ${cat.color};`}>
                Shop Now →
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Flagship Bestsellers Section -->
  <section class="section bestsellers-section" id="bestsellers">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="badge badge-green">Curated Plant Nutrition</span>
          <h2 class="section-title">Explore ManNeeds Products</h2>
          <p class="section-subtitle">Real farm-harvested actives with custom weight options (100g, 200g, 250g, 500g). Select your preferred pack size below.</p>
        </div>
        <div class="header-action-badge">
          <span class="live-status-pill">
            <span class="pulse-dot"></span>
            <span id="product-count-label">22 Products Available</span>
          </span>
        </div>
      </div>

      <!-- Interactive Category Filter Bar -->
      <div class="category-filters-container">
        <div class="category-filters-bar" id="category-filters-bar" role="tablist" aria-label="Filter products by category">
          <button type="button" class="cat-filter-btn active" data-cat="all" role="tab" aria-selected="true">
            <span class="cat-icon">✨</span>
            <span class="cat-name">All Products</span>
            <span class="cat-count-badge" id="badge-count-all">22</span>
          </button>
          <button type="button" class="cat-filter-btn" data-cat="Herbal & Superfood Powders" role="tab" aria-selected="false">
            <span class="cat-icon">🌿</span>
            <span class="cat-name">Herbal Powders</span>
            <span class="cat-count-badge">11</span>
          </button>
          <button type="button" class="cat-filter-btn" data-cat="Healthy Snacks" role="tab" aria-selected="false">
            <span class="cat-icon">🍿</span>
            <span class="cat-name">Healthy Snacks</span>
            <span class="cat-count-badge">3</span>
          </button>
          <button type="button" class="cat-filter-btn" data-cat="Real Fruit Candies" role="tab" aria-selected="false">
            <span class="cat-icon">🍬</span>
            <span class="cat-name">Fruit Candies</span>
            <span class="cat-count-badge">4</span>
          </button>
          <button type="button" class="cat-filter-btn" data-cat="Dried Fruit Chips" role="tab" aria-selected="false">
            <span class="cat-icon">🥭</span>
            <span class="cat-name">Fruit Chips</span>
            <span class="cat-count-badge">3</span>
          </button>
          <button type="button" class="cat-filter-btn" data-cat="Raw Honey & Pure Elixirs" role="tab" aria-selected="false">
            <span class="cat-icon">🍯</span>
            <span class="cat-name">Pure Honey</span>
            <span class="cat-count-badge">1</span>
          </button>
        </div>
      </div>

      <div class="products-grid" id="products-grid">
        {bestsellers.map((item) => {
          const masterStock = item.stockQuantity !== undefined && item.stockQuantity !== null ? Number(item.stockQuantity) : 0;
          const defaultVariant = item.variants && item.variants.length > 0 ? item.variants[0] : null;
          const currentPrice = defaultVariant ? defaultVariant.price : item.price;
          const originalPrice = defaultVariant ? (defaultVariant.originalPrice || item.originalPrice) : item.originalPrice;
          const currentStock = masterStock;
          const currentWeight = defaultVariant ? defaultVariant.weight : '100g';
          const icon = item.category.includes('Honey') ? '🍯' : item.category.includes('Snack') ? '🍿' : item.category.includes('Chip') ? '🥭' : item.category.includes('Cand') ? '🍬' : '🌿';

          return (
            <div 
              class="mn-card product-card"
              data-product-id={item.id}
              data-category={item.category}
              data-product-name={item.name}
              data-selected-weight={currentWeight}
              data-selected-price={currentPrice}
            >
              <!-- Product Visual Banner -->
              <div class="product-visual">
                <span class="discount-badge">{item.discount || '20% OFF'}</span>
                <span class="badge-corner">{item.badge || 'Pure Plant'}</span>
                
                <div class="product-illustration">
                  <div class="bottle-mockup">
                    <span class="mockup-leaf">{icon}</span>
                    <div class="mockup-bubble b1"></div>
                    <div class="mockup-bubble b2"></div>
                  </div>
                </div>

                <div class="flavour-tag">
                  <span>Flavour: <strong>{item.flavour || 'Natural'}</strong></span>
                </div>
              </div>

              <!-- Product Details -->
              <div class="product-content">
                <div class="product-header-meta">
                  <span class="product-cat-name">{item.category}</span>
                  <span class={`stock-indicator ${currentStock <= 10 ? 'low-stock' : ''}`} data-stock-target>
                    {currentStock <= 0 ? '❌ Out of Stock' : currentStock <= 10 ? `🔥 Only ${currentStock} Left` : `✓ Stock: ${currentStock}`}
                  </span>
                </div>

                <h3 class="product-name">{item.name}</h3>
                <p class="product-desc">{item.desc}</p>

                <!-- Weight / Pack Variants Selector -->
                {item.variants && item.variants.length > 0 && (
                  <div class="weight-variants-box">
                    <div class="variants-header-line">
                      <span class="weight-variants-label">Select Pack Size:</span>
                      <span class="weight-selected-badge" data-weight-display>{currentWeight}</span>
                    </div>
                    <div class="weight-pill-group">
                      {item.variants.map((v, vIdx) => (
                        <button
                          type="button"
                          class={`weight-pill ${vIdx === 0 ? 'active' : ''}`}
                          data-weight={v.weight}
                          data-price={v.price}
                          data-orig-price={v.originalPrice || ''}
                          data-stock={vIdx === 0 ? masterStock : (v.stock !== undefined && v.stock !== null ? Number(v.stock) : Math.max(1, Math.floor(masterStock / 2)))}
                          aria-label={`Select ${v.weight} pack`}
                        >
                          <span class="pill-weight">{v.weight}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Price Box -->
                <div class="product-price-row">
                  <div class="price-wrap">
                    <span class="current-price" data-price-target>{currentPrice}</span>
                    {originalPrice && (
                      <span class="original-price" data-orig-price-target>{originalPrice}</span>
                    )}
                  </div>
                  <span class="save-tag">{item.discount || 'SAVE 20%'}</span>
                </div>

                <!-- Add to Cart CTA -->
                <button 
                  type="button"
                  class="btn btn-primary add-to-cart-btn"
                  data-cart-action
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                  <span>Add To Cart</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Why The Daily Fix Works -->
  <section class="section promise-section">
    <div class="container">
      <div class="promise-card">
        <div class="promise-header">
          <span class="badge badge-orange">The ManNeeds Promise</span>
          <h2 class="section-title">Why 2 Million+ People Switched to ManNeeds</h2>
          <p class="section-subtitle">
            We stripped away the harsh chemicals, the pills, and the boring diet culture.
          </p>
        </div>

        <div class="promise-grid">
          <div class="promise-item">
            <div class="promise-icon-wrap bg-green">🌱</div>
            <h4>100% Plant Sourced</h4>
            <p>Every active is extracted from nature — pea protein, apple cider, rosemary, and berries. Zero animal derivatives.</p>
          </div>

          <div class="promise-item">
            <div class="promise-icon-wrap bg-orange">🔬</div>
            <h4>Clinically Validated Actives</h4>
            <p>No guesswork. Formulas are tested in certified labs to ensure high bioavailability and visible results in 60-90 days.</p>
          </div>

          <div class="promise-item">
            <div class="promise-icon-wrap bg-berry">😋</div>
            <h4>Wildly Delicious Taste</h4>
            <p>Made with real fruit aromas and zero added sugar. Nutrition that feels like a treat you crave every single morning.</p>
          </div>

          <div class="promise-item">
            <div class="promise-icon-wrap bg-yellow">🛡️</div>
            <h4>Gentle on Your Gut</h4>
            <p>Lactose-free, non-GMO, and enriched with digestive enzymes so you never face bloating or stomach discomfort.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Quiz Callout -->
  <section class="section quiz-section" id="quiz">
    <div class="container">
      <div class="quiz-box">
        <!-- Intro Screen -->
        <div class="quiz-content" id="quiz-intro">
          <span class="badge badge-green">Personalized Routine</span>
          <h2 class="quiz-title">Find Your Exact Routine in 60 Seconds</h2>
          <p class="quiz-desc">
            Take our doctor-crafted lifestyle questionnaire. Tell us your hair, skin, or wellness goals and get an instant custom recommendation + extra 10% coupon!
          </p>
          <div class="quiz-actions">
            <button class="btn btn-green" id="open-quiz-btn">
              Start The Free Quiz →
            </button>
          </div>
        </div>

        <!-- Interactive Quiz Form -->
        <div class="quiz-form-wrap" id="quiz-form-wrap" style="display: none;">
          <span class="badge badge-orange">Quick Assessment</span>
          <h3 class="quiz-form-title">Select Your Goal & Preference</h3>
          <form id="routine-quiz-form" class="quiz-form">
            <div class="quiz-form-grid">
              <div class="quiz-field">
                <label for="quiz-concern">Primary Wellness Goal:</label>
                <select id="quiz-concern" required class="quiz-select">
                  <option value="Hair Fall Control & Scalp Density">Hair Fall Control & Scalp Density (Rosemary)</option>
                  <option value="Glowing Skin & Dark Spot Reduction">Glowing Skin & Dark Spots (Glutathione)</option>
                  <option value="Gut Detox & Healthy Weight">Gut Detox & Healthy Weight (ACV with Mother)</option>
                  <option value="Instant Debloat & Daily Greens">Instant Debloat & Alkalising Greens</option>
                  <option value="Clean Plant Protein & Muscle">Clean Plant Protein & Lean Muscle</option>
                </select>
              </div>

              <div class="quiz-field">
                <label for="quiz-format">Preferred Format:</label>
                <select id="quiz-format" required class="quiz-select">
                  <option value="Drop & Fizz (Effervescent)">Drop & Fizz (Effervescent Drink)</option>
                  <option value="Targeted Scalp Serum">Targeted Scalp Serum</option>
                  <option value="Chewable Gummies">Chewable Gummies</option>
                  <option value="Plant Protein Shake">Plant Protein Shake</option>
                </select>
              </div>
            </div>

            <div class="quiz-field">
              <label for="quiz-email">Where should we send your custom discount?</label>
              <input type="email" id="quiz-email" placeholder="Enter your email" required class="quiz-input" />
            </div>

            <div class="quiz-form-actions">
              <button type="button" class="btn btn-secondary" id="cancel-quiz-btn">Back</button>
              <button type="submit" class="btn btn-green" id="submit-quiz-btn">Get My Routine & 10% Off →</button>
            </div>
          </form>
        </div>

        <!-- Quiz Result Box -->
        <div class="quiz-result-wrap" id="quiz-result-wrap" style="display: none;">
          <div class="quiz-result-card">
            <span class="badge badge-green">Your Recommended Match</span>
            <h3 id="recommendation-title">ManNeeds Recommended Routine</h3>
            <p id="recommendation-desc" class="recommendation-desc"></p>
            <div class="quiz-coupon-alert">
              Use code <strong class="coupon-highlight">ROUTINE10</strong> for an instant extra 10% off!
            </div>
            <div class="quiz-result-actions">
              <a href="#bestsellers" class="btn btn-primary">Shop This Routine</a>
              <button type="button" class="btn btn-secondary" id="retake-quiz-btn">Retake Quiz</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIP Promo CTA -->
  <section class="section promo-cta-section">
    <div class="container">
      <div class="promo-box">
        <span class="badge badge-orange">Exclusive Welcome Offer</span>
        <h2 class="promo-title">Ready to Take Care & Have Fun?</h2>
        <p class="promo-desc">
          Join over 2,000,000 community members embracing delicious plant wellness. Use code <strong class="promo-code">MANNEEDS15</strong> at checkout for 15% instant savings.
        </p>
        <div class="promo-btn-wrap">
          <a href="#bestsellers" class="btn btn-primary">Start Your Routine Now</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style is:global>
  /* Hero */
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background: radial-gradient(circle at 50% 10%, rgba(255, 104, 56, 0.08) 0%, transparent 60%),
                radial-gradient(circle at 80% 40%, rgba(16, 185, 129, 0.08) 0%, transparent 50%),
                var(--bg-base);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-badge {
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mn-orange);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6.5vw, 4.8rem);
    font-weight: 900;
    line-height: 1.05;
    margin-bottom: 0.75rem;
    letter-spacing: -0.035em;
  }

  .hero-tagline-sub {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 800;
    color: var(--text-secondary);
    letter-spacing: 0.12em;
    margin-bottom: 1.25rem;
  }

  .hero-description {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2.25rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .hero-btn-main {
    padding: 0.95rem 1.85rem;
    font-size: 1.05rem;
  }

  .hero-btn-quiz {
    padding: 0.95rem 1.65rem;
    font-size: 1.05rem;
  }

  /* Pop Drop Fizz 3 Step Box */
  .fizz-steps-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 2rem 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .fizz-step-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .fizz-step-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-primary);
  }

  .fizz-steps-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .fizz-steps-grid {
      flex-direction: row;
      gap: 1rem;
    }
  }

  .fizz-step-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-align: left;
    max-width: 260px;
  }

  .step-circle {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .bg-orange { background: #FFEDD5; color: #EA580C; }
  .bg-green { background: #D1FAE5; color: #059669; }
  .bg-berry { background: #FCE7F3; color: #DB2777; }
  .bg-yellow { background: #FEF3C7; color: #D97706; }

  .fizz-step-item strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--text-primary);
    letter-spacing: 0.03em;
  }

  .fizz-step-item span {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .step-arrow {
    display: none;
    font-size: 1.5rem;
    color: #CBD5E1;
  }

  @media (min-width: 768px) {
    .step-arrow {
      display: block;
    }
  }

  /* Section Styles */
  .section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3.5rem;
  }

  .section-header-flex {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.75rem;
  }

  @media (min-width: 768px) {
    .section-header-flex {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .section-title {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  /* Categories Grid */
  .categories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

