---
import MainLayout from '../layouts/MainLayout.astro';
import { 
  getProducts, 
  getInventorySummary, 
  getStockItems, 
  getNewStockInventory, 
  getSoldItems 
} from '../lib/db';
import { isSupabaseConfigured } from '../lib/supabase';

// Fetch server-rendered initial data
const products = await getProducts();
const inventorySummary = await getInventorySummary();
const stockItems = await getStockItems();
const newStockInventory = await getNewStockInventory();
const soldItems = await getSoldItems();

// Calculate totals
const totalInitialStock = inventorySummary.reduce((sum, item) => sum + item.initial_stock, 0);
const totalNewStock = inventorySummary.reduce((sum, item) => sum + item.new_stock, 0);
const totalSold = inventorySummary.reduce((sum, item) => sum + item.sold_stock, 0);
const totalAvailable = inventorySummary.reduce((sum, item) => sum + item.available_quantity, 0);
const lowStockCount = inventorySummary.filter((item) => item.available_quantity > 0 && item.available_quantity <= 15).length;
const outOfStockCount = inventorySummary.filter((item) => item.available_quantity === 0).length;
---

<MainLayout 
  title="Inventory Operations & Stock Tables — ManNeeds"
  description="Manage 3-table inventory architecture: Stock Items (Opening), New Stock Inventory (Inward Batches), and Sold Items (Sales Outflow)."
>
  <div class="inventory-page-wrapper">
    <div class="container">
      
      <!-- Top Breadcrumbs / Navigation -->
      <div class="inventory-breadcrumbs">
        <a href="/" class="crumb-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Storefront
        </a>
        <span class="crumb-separator">/</span>
        <span class="crumb-current">Inventory & Stock Operations</span>
        <span class="status-pill {isSupabaseConfigured ? 'pill-connected' : 'pill-offline'}">
          <span class="pulse-dot"></span>
          {isSupabaseConfigured ? 'Supabase Live Sync' : 'Local Fallback Mode'}
        </span>
      </div>

      <!-- Hero Header & Formula Banner -->
      <div class="inventory-hero">
        <div class="hero-text">
          <span class="hero-badge">3-TABLE INVENTORY CONTROL</span>
          <h1 class="hero-title">Live Stock & Inventory Architecture</h1>
          <p class="hero-subtitle">
            Relational multi-table inventory ledger keeping storefront quantities synchronized in real time.
          </p>
        </div>

        <!-- THE FORMULA CARD -->
        <div class="formula-card">
          <div class="formula-header">
            <span class="formula-label">MATHEMATICAL BALANCE EQUATION</span>
            <span class="formula-status">Enforced in Database</span>
          </div>
          <div class="formula-equation">
            <div class="eq-term term-stock">
              <span class="eq-tag">Table 1</span>
              <span class="eq-name">Opening Stock</span>
              <span class="eq-code">stock_items</span>
              <span class="eq-val" id="total-stat-stock">{totalInitialStock}</span>
            </div>
            <div class="eq-op">+</div>
            <div class="eq-term term-new">
              <span class="eq-tag">Table 2</span>
              <span class="eq-name">New Stock</span>
              <span class="eq-code">new_stock_inventory</span>
              <span class="eq-val" id="total-stat-new">{totalNewStock}</span>
            </div>
            <div class="eq-op">−</div>
            <div class="eq-term term-sold">
              <span class="eq-tag">Table 3</span>
              <span class="eq-name">Sold Items</span>
              <span class="eq-code">sold_items</span>
              <span class="eq-val" id="total-stat-sold">{totalSold}</span>
            </div>
            <div class="eq-op">=</div>
            <div class="eq-term term-available">
              <span class="eq-tag">Balance</span>
              <span class="eq-name">Available Quantity</span>
              <span class="eq-code">products.stock_quantity</span>
              <span class="eq-val" id="total-stat-available">{totalAvailable}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-icon metric-icon-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <div class="metric-info">
            <span class="metric-label">Total SKUs Tracked</span>
            <span class="metric-val">{products.length} Products</span>
            <span class="metric-sub">Across 5 Categories</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="metric-info">
            <span class="metric-label">Units Available For Sale</span>
            <span class="metric-val" id="metric-avail-display">{totalAvailable} Units</span>
            <span class="metric-sub text-success">✓ Ready for customer orders</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01"/></svg>
          </div>
          <div class="metric-info">
            <span class="metric-label">Low & Out of Stock Alerts</span>
            <span class="metric-val text-warning">{lowStockCount} Low Stock</span>
            <span class="metric-sub">{outOfStockCount > 0 ? `${outOfStockCount} out of stock` : '0 out of stock'} • Need restock</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
          </div>
          <div class="metric-info">
            <span class="metric-label">Quick Actions</span>
            <div class="quick-action-btns">
              <button class="btn-action-primary" id="open-add-stock-btn">+ Add Stock</button>
              <button class="btn-action-secondary" id="open-record-sale-btn">− Record Sale</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Action & Filter Bar -->
      <div class="table-toolbar">
        <!-- Tabs -->
        <div class="tab-buttons" role="tablist">
          <button class="tab-btn active" data-tab="tab-summary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            Summary & Balance
            <span class="tab-badge">{inventorySummary.length}</span>
          </button>
          <button class="tab-btn" data-tab="tab-stock-items">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            1. Stock Items (Opening)
            <span class="tab-badge">{stockItems.length}</span>
          </button>
          <button class="tab-btn" data-tab="tab-new-stock">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
            2. New Stock Inventory
            <span class="tab-badge">{newStockInventory.length}</span>
          </button>
          <button class="tab-btn" data-tab="tab-sold-items">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            3. Sold Items
            <span class="tab-badge">{soldItems.length}</span>
          </button>
        </div>

        <!-- Search & Category Filters -->
        <div class="toolbar-controls">
          <div class="search-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="inventory-search" placeholder="Filter by product name..." />
          </div>

          <select id="category-filter" class="category-select">
            <option value="all">All Categories</option>
            <option value="Healthy Snacks">Healthy Snacks</option>
            <option value="Real Fruit Candies">Real Fruit Candies</option>
            <option value="Raw Honey & Pure Elixirs">Raw Honey</option>
            <option value="Pure Stone-Ground Spices">Spices</option>
            <option value="Grains, Flours & Pulses">Grains & Pulses</option>
          </select>
        </div>
      </div>

      <!-- ============================================================== -->
      <!-- TAB 1: SUMMARY & BALANCE (The Core Formula Table) -->
      <!-- ============================================================== -->
      <div class="tab-panel active" id="tab-summary">
        <div class="inventory-table-container">
          <table class="inventory-table" id="summary-table">
            <thead>
              <tr>
                <th style="width: 60px;">ID</th>
                <th>Product Name & Category</th>
                <th style="width: 120px;">Unit Price</th>
                <th style="width: 140px; text-align: center;" class="th-stock">
                  Initial Stock
                  <span class="col-formula-tag">stock_items [1]</span>
                </th>
                <th style="width: 140px; text-align: center;" class="th-new">
                  New Stock
                  <span class="col-formula-tag">new_stock [2]</span>
                </th>
                <th style="width: 140px; text-align: center;" class="th-sold">
                  Sold Items
                  <span class="col-formula-tag">sold_items [3]</span>
                </th>
                <th style="width: 160px; text-align: center;" class="th-available">
                  Available Qty
                  <span class="col-formula-tag">[1] + [2] − [3]</span>
                </th>
                <th style="width: 130px; text-align: center;">Status</th>
                <th style="width: 140px; text-align: right;">Quick Operations</th>
              </tr>
            </thead>
            <tbody>
              {inventorySummary.map((item) => {
                const isOutOfStock = item.available_quantity <= 0;
                const isLowStock = !isOutOfStock && item.available_quantity <= 15;

                return (
                  <tr 
                    class="product-row" 
                    data-product-id={item.product_id}
                    data-name={item.product_name.toLowerCase()}
                    data-category={item.category}
                  >
                    <td class="cell-id">#{item.product_id}</td>
                    <td class="cell-name">
                      <div class="product-title-wrap">
                        <span class="product-title">{item.product_name}</span>
                        <span class="product-cat-badge">{item.category}</span>
                      </div>
                    </td>
                    <td class="cell-price">{item.price}</td>
                    <td class="cell-val col-stock text-center">
                      <span class="num-badge badge-stock">{item.initial_stock}</span>
                    </td>
                    <td class="cell-val col-new text-center">
                      <span class="num-badge badge-new">+{item.new_stock}</span>
                    </td>
                    <td class="cell-val col-sold text-center">
                      <span class="num-badge badge-sold">−{item.sold_stock}</span>
                    </td>
                    <td class="cell-val col-available text-center">
                      <span class="num-badge badge-available">
                        {item.available_quantity}
                      </span>
                    </td>
                    <td class="text-center">
                      {isOutOfStock ? (
                        <span class="badge-status status-out">Out of Stock</span>
                      ) : isLowStock ? (
                        <span class="badge-status status-low">Low Stock ({item.available_quantity})</span>
                      ) : (
                        <span class="badge-status status-ok">In Stock</span>
                      )}
                    </td>
                    <td class="text-right">
                      <div class="table-actions">
                        <button 
                          class="btn-row-action btn-add-stock" 
                          data-product-id={item.product_id}
                          data-product-name={item.product_name}
                          title="Add incoming stock shipment"
                        >
                          + Stock
                        </button>
                        <button 
                          class="btn-row-action btn-record-sale" 
                          data-product-id={item.product_id}
                          data-product-name={item.product_name}
                          title="Record sold item"
                        >
                          − Sale
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      <!-- ============================================================== -->
      <!-- TAB 2: TABLE 1 - STOCK ITEMS (Opening Baseline) -->
      <!-- ============================================================== -->
      <div class="tab-panel" id="tab-stock-items">
        <div class="tab-panel-header">
          <div>
            <h3>Table 1: stock_items</h3>
            <p>Represents the baseline opening inventory. Updated when setting initial counts.</p>
          </div>
          <button class="btn-action-primary" id="btn-open-set-initial">Set Baseline Stock</button>
        </div>
        <div class="inventory-table-container">
          <table class="inventory-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Product ID</th>
                <th>Variant Weight</th>
                <th>Opening Quantity</th>
                <th>Unit Cost</th>
                <th>Notes</th>
                <th>Created / Updated</th>
              </tr>
            </thead>
            <tbody id="stock-items-tbody">
              {stockItems.length > 0 ? (
                stockItems.map((si) => (
                  <tr>
                    <td>#{si.id}</td>
                    <td>Product #{si.product_id}</td>
                    <td><span class="tag-variant">{si.variant_weight || 'all'}</span></td>
                    <td><strong>{si.quantity} units</strong></td>
                    <td>{si.unit_cost ? `₹${si.unit_cost}` : '—'}</td>
                    <td>{si.notes || 'Baseline opening stock'}</td>
                    <td class="cell-date">{si.updated_at ? new Date(si.updated_at).toLocaleDateString() : 'Initial'}</td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="7" class="empty-state">
                    No records found in <code>stock_items</code> yet. Run the SQL script in Supabase to migrate opening baseline stock.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- ============================================================== -->
      <!-- TAB 3: TABLE 2 - NEW STOCK INVENTORY (Restocks / Batches) -->
      <!-- ============================================================== -->
      <div class="tab-panel" id="tab-new-stock">
        <div class="tab-panel-header">
          <div>
            <h3>Table 2: new_stock_inventory</h3>
            <p>Ledger of inward batches and restock shipments. Every entry increases available quantity.</p>
          </div>
          <button class="btn-action-primary" id="btn-open-add-new-stock">+ Add New Batch</button>
        </div>
        <div class="inventory-table-container">
          <table class="inventory-table">
            <thead>
              <tr>
                <th>Batch ID</th>
                <th>Product</th>
                <th>Variant</th>
                <th>Quantity Added</th>
                <th>Batch Number</th>
                <th>Supplier</th>
                <th>Received Date</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody id="new-stock-tbody">
              {newStockInventory.length > 0 ? (
                newStockInventory.map((item) => (
                  <tr>
                    <td>#{item.id}</td>
                    <td>Product #{item.product_id}</td>
                    <td><span class="tag-variant">{item.variant_weight || 'all'}</span></td>
                    <td><span class="badge-new">+{item.quantity} units</span></td>
                    <td><code>{item.batch_number || 'N/A'}</code></td>
                    <td>{item.supplier || 'Direct Farm'}</td>
                    <td>{item.received_date || 'Today'}</td>
                    <td>{item.notes || 'Inward batch'}</td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="8" class="empty-state">
                    No inward shipments logged yet in <code>new_stock_inventory</code>. Click "+ Add New Batch" to record new stock.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- ============================================================== -->
      <!-- TAB 4: TABLE 3 - SOLD ITEMS (Sales Outflow) -->
      <!-- ============================================================== -->
      <div class="tab-panel" id="tab-sold-items">
        <div class="tab-panel-header">
          <div>
            <h3>Table 3: sold_items</h3>
            <p>Ledger of outward customer sales and orders. Every entry decrements available quantity.</p>
          </div>
          <button class="btn-action-secondary" id="btn-open-record-sale-2">− Record Sale</button>
        </div>
        <div class="inventory-table-container">
          <table class="inventory-table">
            <thead>
              <tr>
                <th>Sale ID</th>
                <th>Product</th>
                <th>Variant</th>
                <th>Quantity Sold</th>
                <th>Order Ref</th>
                <th>Unit Price</th>
                <th>Sold Date</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody id="sold-items-tbody">
              {soldItems.length > 0 ? (
                soldItems.map((item) => (
                  <tr>
                    <td>#{item.id}</td>
                    <td>Product #{item.product_id}</td>
                    <td><span class="tag-variant">{item.variant_weight || 'all'}</span></td>
                    <td><span class="badge-sold">−{item.quantity} units</span></td>
                    <td><code>{item.order_id || 'Direct'}</code></td>
                    <td>{item.unit_price ? `₹${item.unit_price}` : '—'}</td>
                    <td>{item.sold_date || 'Today'}</td>
                    <td>{item.notes || 'Customer sale'}</td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="8" class="empty-state">
                    No sales recorded yet in <code>sold_items</code>. Click "− Record Sale" to test deducting stock.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MODAL: ADD NEW STOCK (Table 2: new_stock_inventory) -->
  <!-- ============================================================== -->
  <div class="inventory-modal-backdrop" id="modal-add-stock">
    <div class="inventory-modal-content">
      <div class="modal-header">
        <div>
          <span class="modal-pre">TABLE 2: NEW STOCK INVENTORY</span>
          <h3 class="modal-title">Receive Inward Stock Batch</h3>
        </div>
        <button class="modal-close" data-close-modal="modal-add-stock">&times;</button>
      </div>
      <form id="form-add-stock" class="modal-form">
        <div class="form-group">
          <label for="new-stock-product">Select Product *</label>
          <select id="new-stock-product" required class="form-control">
            <option value="">-- Choose Product --</option>
            {products.map((p) => (
              <option value={p.id}>{p.name} (Current: {p.stockQuantity ?? 0})</option>
            ))}
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="new-stock-variant">Variant / Weight</label>
            <input type="text" id="new-stock-variant" placeholder="e.g. 100g, 200g, all" value="all" class="form-control" />
          </div>
          <div class="form-group">
            <label for="new-stock-qty">Quantity to Add *</label>
            <input type="number" id="new-stock-qty" min="1" required placeholder="e.g. 25" class="form-control" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="new-stock-batch">Batch / Lot Number</label>
            <input type="text" id="new-stock-batch" placeholder="e.g. BATCH-2026-A1" class="form-control" />
          </div>
          <div class="form-group">
            <label for="new-stock-supplier">Supplier / Source</label>
            <input type="text" id="new-stock-supplier" placeholder="e.g. Coorg Spice Estate" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label for="new-stock-notes">Notes / Reference</label>
          <input type="text" id="new-stock-notes" placeholder="e.g. Farm fresh harvest restock" class="form-control" />
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancel" data-close-modal="modal-add-stock">Cancel</button>
          <button type="submit" class="btn-submit" id="btn-submit-new-stock">Add to New Stock Inventory</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MODAL: RECORD SOLD ITEM (Table 3: sold_items) -->
  <!-- ============================================================== -->
  <div class="inventory-modal-backdrop" id="modal-record-sale">
    <div class="inventory-modal-content">
      <div class="modal-header">
        <div>
          <span class="modal-pre">TABLE 3: SOLD ITEMS</span>
          <h3 class="modal-title">Record Outward Sale / Order Deduction</h3>
        </div>
        <button class="modal-close" data-close-modal="modal-record-sale">&times;</button>
      </div>
      <form id="form-record-sale" class="modal-form">
        <div class="form-group">
          <label for="sold-product">Select Product *</label>
          <select id="sold-product" required class="form-control">
            <option value="">-- Choose Product --</option>
            {products.map((p) => (
              <option value={p.id}>{p.name} (Available: {p.stockQuantity ?? 0})</option>
            ))}
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="sold-variant">Variant / Weight</label>
            <input type="text" id="sold-variant" placeholder="e.g. 100g, 200g, all" value="all" class="form-control" />
          </div>
          <div class="form-group">
            <label for="sold-qty">Quantity Sold *</label>
            <input type="number" id="sold-qty" min="1" required placeholder="e.g. 2" class="form-control" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="sold-order-id">Order Reference / ID</label>
            <input type="text" id="sold-order-id" placeholder="e.g. ORD-9842" class="form-control" />
          </div>
          <div class="form-group">
            <label for="sold-unit-price">Unit Price (₹)</label>
            <input type="number" id="sold-unit-price" placeholder="e.g. 199" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label for="sold-notes">Sale Notes</label>
          <input type="text" id="sold-notes" placeholder="e.g. Website checkout order" class="form-control" />
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancel" data-close-modal="modal-record-sale">Cancel</button>
          <button type="submit" class="btn-submit btn-submit-sold" id="btn-submit-sold">Deduct From Available Stock</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MODAL: SET BASELINE STOCK (Table 1: stock_items) -->
  <!-- ============================================================== -->
  <div class="inventory-modal-backdrop" id="modal-set-initial">
    <div class="inventory-modal-content">
      <div class="modal-header">
        <div>
          <span class="modal-pre">TABLE 1: STOCK ITEMS</span>
          <h3 class="modal-title">Set Opening Baseline Stock</h3>
        </div>
        <button class="modal-close" data-close-modal="modal-set-initial">&times;</button>
      </div>
      <form id="form-set-initial" class="modal-form">
        <div class="form-group">
          <label for="initial-product">Select Product *</label>
          <select id="initial-product" required class="form-control">
            <option value="">-- Choose Product --</option>
            {products.map((p) => (
              <option value={p.id}>{p.name} (Current: {p.stockQuantity ?? 0})</option>
            ))}
          </select>
        </div>

        <div class="form-row">
