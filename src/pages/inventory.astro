<!-- Client Script for Interactive Live Updates, Tab Switching, and Supabase Operations -->
<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';
  import { addNewStock, recordSoldItem, updateInitialStock } from '../lib/db';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Switching Logic
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const tabPanels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab');
        tabButtons.forEach((b) => b.classList.remove('active'));
        tabPanels.forEach((p) => p.classList.remove('active'));

        btn.classList.add('active');
        if (targetId) {
          const panel = document.getElementById(targetId);
          if (panel) panel.classList.add('active');
        }
      });
    });

    // 2. Search & Category Filters
    const searchInput = document.getElementById('inventory-search') as HTMLInputElement | null;
    const categorySelect = document.getElementById('category-filter') as HTMLSelectElement | null;
    const rows = document.querySelectorAll<HTMLTableRowElement>('.product-row');

    function filterTable() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const cat = categorySelect?.value || 'all';

      rows.forEach((row) => {
        const name = row.getAttribute('data-name') || '';
        const category = row.getAttribute('data-category') || '';

        const matchesQuery = !q || name.includes(q);
        const matchesCategory = cat === 'all' || category === cat;

        row.style.display = matchesQuery && matchesCategory ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', filterTable);
    categorySelect?.addEventListener('change', filterTable);

    // 3. Modal Management
    const modalAddStock = document.getElementById('modal-add-stock');
    const modalRecordSale = document.getElementById('modal-record-sale');
    const modalSetInitial = document.getElementById('modal-set-initial');

    function openModal(modal: HTMLElement | null) {
      if (modal) modal.classList.add('open');
    }

    function closeModal(modal: HTMLElement | null) {
      if (modal) modal.classList.remove('open');
    }

    document.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetModalId = btn.getAttribute('data-close-modal');
        if (targetModalId) closeModal(document.getElementById(targetModalId));
      });
    });

    // Trigger buttons
    document.getElementById('open-add-stock-btn')?.addEventListener('click', () => openModal(modalAddStock));
    document.getElementById('btn-open-add-new-stock')?.addEventListener('click', () => openModal(modalAddStock));
    document.getElementById('open-record-sale-btn')?.addEventListener('click', () => openModal(modalRecordSale));
    document.getElementById('btn-open-record-sale-2')?.addEventListener('click', () => openModal(modalRecordSale));
    document.getElementById('btn-open-set-initial')?.addEventListener('click', () => openModal(modalSetInitial));

    // Row-specific triggers
    document.querySelectorAll('.btn-add-stock').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pid = btn.getAttribute('data-product-id');
        const select = document.getElementById('new-stock-product') as HTMLSelectElement | null;
        if (select && pid) select.value = pid;
        openModal(modalAddStock);
      });
    });

    document.querySelectorAll('.btn-record-sale').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pid = btn.getAttribute('data-product-id');
        const select = document.getElementById('sold-product') as HTMLSelectElement | null;
        if (select && pid) select.value = pid;
        openModal(modalRecordSale);
      });
    });

    // 4. Handle Add New Stock Submission (Table 2)
    const formAddStock = document.getElementById('form-add-stock') as HTMLFormElement | null;
    formAddStock?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pid = Number((document.getElementById('new-stock-product') as HTMLSelectElement)?.value);
      const variant = (document.getElementById('new-stock-variant') as HTMLInputElement)?.value || 'all';
      const qty = Number((document.getElementById('new-stock-qty') as HTMLInputElement)?.value);
      const batch = (document.getElementById('new-stock-batch') as HTMLInputElement)?.value;
      const supplier = (document.getElementById('new-stock-supplier') as HTMLInputElement)?.value;
      const notes = (document.getElementById('new-stock-notes') as HTMLInputElement)?.value;

      if (!pid || qty <= 0) {
        alert('Please select a product and enter a valid quantity.');
        return;
      }

      const submitBtn = document.getElementById('btn-submit-new-stock') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Recording in Supabase...';
      }

      try {
        const result = await addNewStock({
          productId: pid,
          variantWeight: variant,
          quantity: qty,
          batchNumber: batch,
          supplier: supplier,
          notes: notes
        });

        if (result.success) {
          alert(`✓ Added ${qty} units to Table 2 (new_stock_inventory)!\nAvailable stock recalculated automatically via database trigger.`);
          closeModal(modalAddStock);
          formAddStock.reset();
          // Reload page to reflect fresh database view
          window.location.reload();
        } else {
          alert(`Notice: ${result.message}\nMake sure to run 'supabase/inventory_tables.sql' in your Supabase SQL editor.`);
        }
      } catch (err: any) {
        alert(`Error: ${err?.message || 'Could not record new stock'}`);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Add to New Stock Inventory';
        }
      }
    });

    // 5. Handle Record Sale Submission (Table 3)
    const formRecordSale = document.getElementById('form-record-sale') as HTMLFormElement | null;
    formRecordSale?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pid = Number((document.getElementById('sold-product') as HTMLSelectElement)?.value);
      const variant = (document.getElementById('sold-variant') as HTMLInputElement)?.value || 'all';
      const qty = Number((document.getElementById('sold-qty') as HTMLInputElement)?.value);
      const orderId = (document.getElementById('sold-order-id') as HTMLInputElement)?.value;
      const unitPrice = Number((document.getElementById('sold-unit-price') as HTMLInputElement)?.value) || undefined;
      const notes = (document.getElementById('sold-notes') as HTMLInputElement)?.value;

      if (!pid || qty <= 0) {
        alert('Please select a product and enter a valid quantity.');
        return;
      }

      const submitBtn = document.getElementById('btn-submit-sold') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Deducting Stock...';
      }

      try {
        const result = await recordSoldItem({
          productId: pid,
          variantWeight: variant,
          quantity: qty,
          orderId: orderId,
          unitPrice: unitPrice,
          notes: notes
        });

        if (result.success) {
          alert(`✓ Recorded ${qty} sold units in Table 3 (sold_items)!\nAvailable stock deducted automatically via database trigger.`);
          closeModal(modalRecordSale);
          formRecordSale.reset();
          window.location.reload();
        } else {
          alert(`Notice: ${result.message}\nMake sure to run 'supabase/inventory_tables.sql' in your Supabase SQL editor.`);
        }
      } catch (err: any) {
        alert(`Error: ${err?.message || 'Could not record sale'}`);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Deduct From Available Stock';
        }
      }
    });

    // 6. Handle Set Baseline Stock (Table 1: stock_items)
    const formSetInitial = document.getElementById('form-set-initial') as HTMLFormElement | null;
    formSetInitial?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pid = Number((document.getElementById('initial-product') as HTMLSelectElement)?.value);
      const variant = (document.getElementById('initial-variant') as HTMLInputElement)?.value || 'all';
      const qty = Number((document.getElementById('initial-qty') as HTMLInputElement)?.value);
      const cost = Number((document.getElementById('initial-cost') as HTMLInputElement)?.value) || undefined;
      const notes = (document.getElementById('initial-notes') as HTMLInputElement)?.value;

      if (!pid || qty < 0) {
        alert('Please select a product and enter a non-negative quantity.');
        return;
      }

      const submitBtn = document.getElementById('btn-submit-initial') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Updating Baseline...';
      }

      try {
        const result = await updateInitialStock({
          productId: pid,
          variantWeight: variant,
          quantity: qty,
          unitCost: cost,
          notes: notes
        });

        if (result.success) {
          alert(`✓ Updated baseline opening stock to ${qty} in Table 1 (stock_items)!\nAvailable stock recalculated automatically via database trigger.`);
          closeModal(modalSetInitial);
          formSetInitial.reset();
          window.location.reload();
        } else {
          alert(`Notice: ${result.message}\nMake sure to run 'supabase/inventory_tables.sql' in your Supabase SQL editor.`);
        }
      } catch (err: any) {
        alert(`Error: ${err?.message || 'Could not update initial stock'}`);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Update Baseline Stock';
        }
      }
    });

    // 7. Supabase Realtime Listener (Updates quantities live without reload!)
    if (isSupabaseConfigured) {
      try {
        supabase
          .channel('inventory-changes')
          .on('postgres_changes', { event: '*', schema: 'public', table: 'products' }, (payload: any) => {
            console.log('[Realtime] Product stock updated:', payload);
            if (payload?.new?.id) {
              const updatedRow = document.querySelector<HTMLTableRowElement>(`.product-row[data-product-id="${payload.new.id}"]`);
              if (updatedRow) {
                const availCell = updatedRow.querySelector('.badge-available');
                if (availCell) {
                  availCell.textContent = String(payload.new.stock_quantity ?? 0);
                  availCell.classList.add('flash-update');
                  setTimeout(() => availCell.classList.remove('flash-update'), 2000);
                }
              }
            }
          })
          .subscribe();
      } catch (e) {
        console.warn('Realtime channel subscribe notice:', e);
      }
    }
  });
</script>
