<script define:vars={{ productId: product.id, productName: cleanName, productCat: product.category, defaultWeight: defaultVar.weight, defaultPrice: defaultVar.price, defaultOrig: defaultVar.originalPrice || '' }}>
  let selectedWeight = defaultWeight;
  let selectedPrice = defaultPrice;
  let selectedOrig = defaultOrig;

  // Thumbnail switcher
  const mainImg = document.getElementById('pdp-main-image');
  document.querySelectorAll('.pdp-thumb-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-thumb-src');
      if (mainImg && src) mainImg.setAttribute('src', src);
      document.querySelectorAll('.pdp-thumb-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Pack size selector
  const curPriceEl = document.getElementById('pdp-current-price');
  const origPriceEl = document.getElementById('pdp-orig-price');
  const offTagEl = document.getElementById('pdp-off-tag');
  const stickyPriceEl = document.getElementById('pdp-sticky-price');
  const stickyWeightEl = document.getElementById('pdp-sticky-weight');
  const waBtn = document.getElementById('pdp-wa-btn');

  document.querySelectorAll('.pdp-variant-card').forEach((card) => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.pdp-variant-card').forEach((c) => c.classList.remove('active'));
      card.classList.add('active');
      selectedWeight = card.getAttribute('data-var-weight') || defaultWeight;
      selectedPrice = card.getAttribute('data-var-price') || defaultPrice;
      selectedOrig = card.getAttribute('data-var-orig') || '';

      if (curPriceEl) curPriceEl.textContent = selectedPrice;
      if (origPriceEl) {
        origPriceEl.textContent = selectedOrig;
        origPriceEl.style.display = selectedOrig ? '' : 'none';
      }
      if (stickyPriceEl) stickyPriceEl.textContent = selectedPrice;
      if (stickyWeightEl) stickyWeightEl.textContent = selectedWeight;

      if (offTagEl && selectedPrice && selectedOrig) {
        const p = parseFloat(selectedPrice.replace(/[^\d.]/g, ''));
        const o = parseFloat(selectedOrig.replace(/[^\d.]/g, ''));
        if (o > p && o > 0) offTagEl.textContent = `${Math.round(((o - p) / o) * 100)}% OFF`;
      }
      if (waBtn) {
        waBtn.setAttribute('href', `https://wa.me/919748973335?text=${encodeURIComponent(`Hi ManNeeds! I want to order ${productName} (${selectedWeight}).`)}`);
      }
    });
  });

  function handleAddToCart(btnEl) {
    if (window.manneedsCart?.add) {
      window.manneedsCart.add({
        id: String(productId),
        name: productName,
        weight: selectedWeight,
        price: selectedPrice,
        originalPrice: selectedOrig || undefined,
        category: productCat
      });
      if (btnEl) {
        const prev = btnEl.innerHTML;
        btnEl.innerHTML = '<span>✓ Added to Cart</span>';
        setTimeout(() => { btnEl.innerHTML = prev; }, 1200);
      }
    }
  }

  document.getElementById('pdp-add-to-cart-btn')?.addEventListener('click', (e) => handleAddToCart(e.currentTarget));
  document.getElementById('pdp-sticky-add-btn')?.addEventListener('click', (e) => handleAddToCart(e.currentTarget));

  // Pincode check
  const pinBtn = document.getElementById('pdp-pin-btn');
  const pinInput = document.getElementById('pdp-pin-input');
  const pinResult = document.getElementById('pdp-pin-result');
  pinBtn?.addEventListener('click', async () => {
    const pin = (pinInput?.value || '').replace(/\D/g, '');
    if (pin.length !== 6) {
      if (pinResult) {
        pinResult.style.display = 'block';
        pinResult.style.color = '#DC2626';
        pinResult.textContent = 'Please enter a valid 6-digit Indian pincode.';
      }
      return;
    }
    try {
      const res = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
      const json = await res.json();
      const po = json?.[0]?.PostOffice?.[0];
      if (pinResult) {
        pinResult.style.display = 'block';
        pinResult.style.color = '#15803D';
        pinResult.textContent = po
          ? `✓ Deliverable to ${po.District}, ${po.State} (${pin}) · Estimated 3–5 days`
          : `✓ Deliverable to ${pin} · Estimated 3–6 days`;
      }
    } catch {
      if (pinResult) {
        pinResult.style.display = 'block';
        pinResult.textContent = `✓ Deliverable to ${pin} · Estimated 3–6 days`;
      }
    }
  });
</script>
