---
import MainLayout from '../../layouts/MainLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { DEFAULT_PRODUCTS, getProducts, cleanProductName } from '../../lib/db';

function getLocalMedia(folder?: string): { images: string[]; videos: string[] } {
  if (!folder) return { images: [], videos: [] };
  const baseDir = path.resolve('./public/images/products', folder);
  const images: string[] = [];
  const videos: string[] = [];
  const imageExts = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif', '.gif', '.svg']);
  const videoExts = new Set(['.mp4', '.webm', '.ogg', '.mov']);

  function scan(dir: string, urlPrefix: string) {
    if (!fs.existsSync(dir)) return;
    try {
      const entries = fs.readdirSync(dir, { withFileTypes: true });
      for (const entry of entries) {
        if (entry.isFile() && !entry.name.startsWith('.')) {
          const ext = path.extname(entry.name).toLowerCase();
          if (imageExts.has(ext)) images.push(`${urlPrefix}/${entry.name}`);
          else if (videoExts.has(ext)) videos.push(`${urlPrefix}/${entry.name}`);
        }
      }
    } catch {}
  }

  scan(baseDir, `/images/products/${folder}`);
  scan(path.join(baseDir, 'images'), `/images/products/${folder}/images`);
  scan(path.join(baseDir, 'videos'), `/images/products/${folder}/videos`);
  return { images, videos };
}

export async function getStaticPaths() {
  const products = await getProducts();
  const list = products && products.length > 0 ? products : DEFAULT_PRODUCTS;
  return list.map((item) => ({
    params: { id: String(item.id) },
    props: { product: item, allProducts: list }
  }));
}

const { product, allProducts } = Astro.props;
const cleanName = cleanProductName(product.name);
const localMedia = getLocalMedia(product.folder);
const images = product.images && product.images.length > 0
  ? product.images
  : localMedia.images.length > 0
    ? localMedia.images
    : (product.image || product.imageUrl ? [product.image || product.imageUrl || ''] : []);

const variants = product.variants && product.variants.length > 0
  ? product.variants
  : [{ weight: '100g', price: product.price, originalPrice: product.originalPrice, stock: product.stockQuantity ?? 20 }];

const defaultVar = variants[0];
const masterStock = product.stockQuantity !== undefined && product.stockQuantity !== null ? Number(product.stockQuantity) : 0;
const icon = product.category.includes('Honey') ? '🍯' : product.category.includes('Snack') ? '🍿' : product.category.includes('Chip') ? '🥭' : product.category.includes('Cand') ? '🍬' : '🌿';

const relatedProducts = allProducts
  .filter((p: any) => p.id !== product.id && p.category === product.category)
  .slice(0, 4)
  .map((p: any) => {
    const m = getLocalMedia(p.folder);
    const img = (p.images && p.images[0]) || m.images[0] || p.image || p.imageUrl || '';
    return { ...p, resolvedImg: img };
  });
---

<MainLayout
  title={`${cleanName} (${defaultVar.weight}) | ManNeeds`}
  description={product.desc}
>
  <!-- Instamart-Style Breadcrumb -->
  <div class="pdp-breadcrumb-bar">
    <div class="container pdp-breadcrumb-inner">
      <a href="/" class="pdp-back-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>Back</span>
      </a>
      <nav class="pdp-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/#bestsellers">{product.category}</a>
        <span>/</span>
        <span class="crumb-current">{cleanName}</span>
      </nav>
    </div>
  </div>

  <!-- Instamart-Style Product Detail Layout -->
  <section class="pdp-main-section">
    <div class="container">
      <div class="pdp-grid">
        <!-- Left Column: Visual Gallery -->
        <div class="pdp-gallery-col">
          <div class="pdp-gallery-card">
            <div class="pdp-badges-top">
              <span class="pdp-discount-pill" id="pdp-discount-badge">{product.discount || '20% OFF'}</span>
              {product.badge && <span class="pdp-tag-pill">{product.badge}</span>}
            </div>

            <div class="pdp-main-img-wrap">
              {images.length > 0 ? (
                <img
                  id="pdp-main-image"
                  src={images[0]}
                  alt={cleanName}
                  class="pdp-main-img"
                />
              ) : (
                <div class="pdp-emblem-fallback">
                  <span class="pdp-emblem-icon">{icon}</span>
                  <span class="pdp-emblem-text">100% PURE HARVEST</span>
                </div>
              )}
            </div>

            {images.length > 1 && (
              <div class="pdp-thumbs-row" id="pdp-thumbs-row">
                {images.map((imgUrl: string, idx: number) => (
                  <button
                    type="button"
                    class={`pdp-thumb-btn ${idx === 0 ? 'active' : ''}`}
                    data-thumb-src={imgUrl}
                    aria-label={`View image ${idx + 1}`}
                  >
                    <img src={imgUrl} alt={`${cleanName} thumbnail ${idx + 1}`} />
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Right Column: Sticky Purchase Panel -->
        <div class="pdp-info-col">
          <div class="pdp-brand-row">
            <span class="pdp-brand-chip">MANNEEDS</span>
            <span class="pdp-cat-label">{product.category}</span>
            <span class={`pdp-stock-pill ${masterStock <= 10 ? 'low' : ''}`} id="pdp-stock-pill">
              {masterStock <= 0 ? 'Out of stock' : masterStock <= 10 ? `🔥 Only ${masterStock} left` : `${masterStock} in stock`}
            </span>
          </div>

          <h1 class="pdp-title">{cleanName}</h1>

          <div class="pdp-rating-row">
            {Number(product.reviews) > 0 && Number(product.rating) > 0 ? (
              <>
                <div class="pdp-rating-badge">
                  <span>★</span>
                  <strong>{product.rating}</strong>
                </div>
                <span class="pdp-review-count">({product.reviews} verified {Number(product.reviews) === 1 ? 'rating' : 'ratings'})</span>
              </>
            ) : (
              <span class="pdp-review-count">✨ New Harvest · Be the first to review after delivery</span>
            )}
            {product.flavour && <span class="pdp-flavour-chip">Variant: <strong>{product.flavour}</strong></span>}
          </div>

          <!-- Instamart-Style Unit / Pack Size Selector -->
          <div class="pdp-unit-section">
            <div class="pdp-unit-header">
              <span>Select Unit</span>
              <span class="pdp-unit-count">{variants.length} pack {variants.length === 1 ? 'size' : 'sizes'}</span>
            </div>
            <div class="pdp-variants-grid" id="pdp-variants-grid">
              {variants.map((v: any, idx: number) => {
                const pNum = parseFloat(String(v.price).replace(/[^\d.]/g, '')) || 0;
                const oNum = parseFloat(String(v.originalPrice || '').replace(/[^\d.]/g, '')) || 0;
                const saveAmt = oNum > pNum ? Math.round(oNum - pNum) : 0;
                return (
                  <button
                    type="button"
                    class={`pdp-variant-card ${idx === 0 ? 'active' : ''}`}
                    data-var-weight={v.weight}
                    data-var-price={v.price}
                    data-var-orig={v.originalPrice || ''}
                  >
                    {saveAmt > 0 && <span class="pdp-var-save">SAVE ₹{saveAmt}</span>}
                    <span class="pdp-var-weight">{v.weight}</span>
                    <div class="pdp-var-prices">
                      <strong>{v.price}</strong>
                      {v.originalPrice && <span>{v.originalPrice}</span>}
                    </div>
                  </button>
                );
              })}
            </div>
          </div>

          <!-- Active Price Box -->
          <div class="pdp-price-card">
            <div class="pdp-price-left">
              <div class="pdp-price-main-row">
                <span class="pdp-current-price" id="pdp-current-price">{defaultVar.price}</span>
                {defaultVar.originalPrice && (
                  <span class="pdp-orig-price" id="pdp-orig-price">{defaultVar.originalPrice}</span>
                )}
                <span class="pdp-off-tag" id="pdp-off-tag">{product.discount || '20% OFF'}</span>
              </div>
              <span class="pdp-tax-note">Inclusive of all taxes · Use code <strong>MANNEEDS15</strong> for extra 15% OFF</span>
            </div>
          </div>

          <!-- Primary CTA Buttons -->
          <div class="pdp-cta-row">
            <button type="button" class="btn btn-primary pdp-add-btn" id="pdp-add-to-cart-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span>Add to Cart</span>
            </button>
            <a
              id="pdp-wa-btn"
              href={`https://wa.me/919748973335?text=${encodeURIComponent(`Hi ManNeeds! I want to order ${cleanName} (${defaultVar.weight}).`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn pdp-wa-btn"
            >
              Order via WhatsApp
            </a>
          </div>

          <!-- Instamart Express Delivery & Pincode Checker -->
          <div class="pdp-delivery-box">
            <div class="pdp-delivery-top">
              <span class="pdp-del-icon">⚡</span>
              <div>
                <strong>Express Dispatch in 24–48 Hours</strong>
                <span>Free delivery on orders ₹499+ · Pan-India shipping</span>
              </div>
            </div>
            <div class="pdp-pin-check">
              <input type="text" id="pdp-pin-input" maxlength="6" inputmode="numeric" placeholder="Check delivery pincode (e.g. 700001)" />
              <button type="button" id="pdp-pin-btn">Check</button>
            </div>
            <p class="pdp-pin-result" id="pdp-pin-result" style="display:none;"></p>
          </div>

          <!-- Instamart Clean-Label Highlights -->
          <div class="pdp-highlights-grid">
            <div class="pdp-hl-item"><span>🌾</span><small>100% Farm Harvest</small></div>
            <div class="pdp-hl-item"><span>🚫</span><small>Zero Palm Oil</small></div>
            <div class="pdp-hl-item"><span>🔬</span><small>NABL Lab Tested</small></div>
            <div class="pdp-hl-item"><span>🛡️</span><small>No Preservatives</small></div>
          </div>

          <!-- Product Information Accordion -->
          <div class="pdp-details-accordion">
            <details open class="pdp-acc-item">
              <summary>Product Details</summary>
              <p>{product.desc}</p>
            </details>
            <details class="pdp-acc-item">
              <summary>Purity &amp; Processing</summary>
              <p>Cold-milled and slow-processed below 40°C in small batches to lock in natural aroma, essential oils, and nutrition. Zero synthetic colors, fillers, or preservatives.</p>
            </details>
            <details class="pdp-acc-item">
              <summary>Storage &amp; Shelf Life</summary>
              <p>Store in a cool, dry place away from direct sunlight. Reseal pouch tightly or transfer to an airtight glass jar after opening. Best before 9–12 months from packaging.</p>
            </details>
            <details class="pdp-acc-item">
              <summary>Customer Support &amp; Replacement</summary>
              <p>7-day hassle-free replacement guarantee for any damaged or incorrect item. Contact us anytime on WhatsApp (+91 97489 73335).</p>
            </details>
          </div>
        </div>
      </div>

      <!-- Related Products -->
      {relatedProducts.length > 0 && (
        <div class="pdp-related-section">
          <h2 class="pdp-related-title">More in {product.category}</h2>
          <div class="pdp-related-grid">
            {relatedProducts.map((rel: any) => (
              <a href={`/product/${rel.id}`} class="pdp-rel-card">
                <div class="pdp-rel-img-wrap">
                  {rel.resolvedImg ? (
                    <img src={rel.resolvedImg} alt={cleanProductName(rel.name)} loading="lazy" />
                  ) : (
                    <span>{icon}</span>
                  )}
                </div>
                <div class="pdp-rel-body">
                  <strong>{cleanProductName(rel.name)}</strong>
                  <div class="pdp-rel-price">
                    <span>{rel.price}</span>
                    {rel.originalPrice && <small>{rel.originalPrice}</small>}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Mobile Sticky Bottom Bar (Swiggy Instamart Style) -->
  <div class="pdp-mobile-sticky-bar">
    <div class="pdp-sticky-price">
      <strong id="pdp-sticky-price">{defaultVar.price}</strong>
      <span id="pdp-sticky-weight">{defaultVar.weight}</span>
    </div>
    <button type="button" class="btn btn-primary pdp-sticky-add" id="pdp-sticky-add-btn">
      Add to Cart
    </button>
  </div>
</MainLayout>

