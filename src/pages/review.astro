---
import MainLayout from '../layouts/MainLayout.astro';
import { getProducts, cleanProductName } from '../lib/db';

const products = await getProducts();
const productNames = products.map((p) => cleanProductName(p.name));
---

<MainLayout
  title="Share Your Review | ManNeeds Pure Indian Kitchen Essentials"
  description="Rate your delivered ManNeeds order. Verified customer ratings are published directly from Supabase."
>
  <section class="section review-page-section">
    <div class="container">
      <div class="review-form-card">
        <div class="review-form-header">
          <span class="badge badge-green">Verified Post-Delivery Feedback</span>
          <h1 class="section-title">How Was Your ManNeeds Order?</h1>
          <p class="section-subtitle">
            Every review on our store comes from real customers 3–4 days after delivery. Your honest rating helps other Indian kitchens choose pure food.
          </p>
        </div>

        <form id="verified-review-form" class="review-form">
          <div class="review-form-row">
            <div class="review-field">
              <label for="rev-name">Your Name *</label>
              <input type="text" id="rev-name" required placeholder="e.g. Arnab Roy" />
            </div>
            <div class="review-field">
              <label for="rev-city">City / State</label>
              <input type="text" id="rev-city" placeholder="e.g. Kolkata, WB" />
            </div>
          </div>

          <div class="review-form-row">
            <div class="review-field">
              <label for="rev-product">Product Ordered *</label>
              <select id="rev-product" required>
                <option value="">Select a product...</option>
                {productNames.map((name) => (
                  <option value={name}>{name}</option>
                ))}
                <option value="Starter Kitchen Box">Starter Kitchen Box (Combo)</option>
                <option value="Wellness Pantry Pack">Wellness Pantry Pack (Combo)</option>
                <option value="Snack & Sweet Bundle">Snack &amp; Sweet Bundle (Combo)</option>
              </select>
            </div>
            <div class="review-field">
              <label for="rev-order-id">Order ID (Optional)</label>
              <input type="text" id="rev-order-id" placeholder="e.g. MN-1042" />
            </div>
          </div>

          <div class="review-field">
            <label>Your Rating *</label>
            <div class="star-picker" id="star-picker" role="radiogroup" aria-label="Select rating from 1 to 5 stars">
              {[1, 2, 3, 4, 5].map((num) => (
                <button
                  type="button"
                  class={`star-pick-btn ${num === 5 ? 'active' : ''}`}
                  data-star={num}
                  aria-label={`${num} star${num > 1 ? 's' : ''}`}
                >
                  ★
                </button>
              ))}
              <span class="star-picker-label" id="star-picker-label">5 / 5 — Loved it!</span>
            </div>
            <input type="hidden" id="rev-rating" value="5" />
          </div>

          <div class="review-field">
            <label for="rev-text">Your Honest Review *</label>
            <textarea
              id="rev-text"
              rows="4"
              required
              placeholder="Tell us about the aroma, freshness, taste, and packaging..."
            ></textarea>
          </div>

          <div class="review-form-actions">
            <button type="submit" class="btn btn-primary review-submit-btn" id="rev-submit-btn">
              Publish Verified Review
            </button>
            <a
              href="https://wa.me/919748973335?text=Hi%20ManNeeds!%20Here%20is%20my%20rating%20for%20my%20recent%20order%3A%20"
              target="_blank"
              rel="noopener noreferrer"
              class="btn whatsapp-support-btn"
              style="margin-top: 0;"
            >
              Or Rate Directly on WhatsApp
            </a>
          </div>

          <div id="rev-status-msg" class="rev-status-msg" style="display: none;"></div>
        </form>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .review-page-section {
    padding: 3.5rem 0 4.5rem;
    background: var(--bg-base);
  }
  .review-form-card {
    max-width: 680px;
    margin: 0 auto;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }
  .review-form-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .review-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .review-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .review-form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .review-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .review-field label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .review-field input,
  .review-field select,
  .review-field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-medium);
    background: var(--bg-base);
    color: var(--text-primary);
    font-size: 0.92rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }
  .review-field input:focus,
  .review-field select:focus,
  .review-field textarea:focus {
    border-color: var(--mn-cta);
  }
  .star-picker {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .star-pick-btn {
    font-size: 1.8rem;
    line-height: 1;
    color: var(--border-medium);
    padding: 0.15rem;
    transition: transform 0.12s ease, color 0.12s ease;
  }
  .star-pick-btn.filled {
    color: #F59E0B;
  }
  .star-pick-btn:hover {
    transform: scale(1.15);
  }
  .star-picker-label {
    margin-left: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-secondary);
  }
  .review-form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }
  .review-submit-btn {
    flex: 1;
    min-width: 200px;
  }
  .rev-status-msg {
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
  }
  .rev-status-msg.success {
    background: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
  }
  .rev-status-msg.error {
    background: #FEF2F2;
    color: #991B1B;
    border: 1px solid #FECACA;
  }
  @media (max-width: 639px) {
    .review-form-card {
      padding: 1.5rem 1.15rem;
    }
  }
</style>

<script>
  import { submitReview, getCustomerProfile } from '../lib/db';

  const params = new URLSearchParams(window.location.search);
  const nameInput = document.getElementById('rev-name') as HTMLInputElement | null;
  const orderInput = document.getElementById('rev-order-id') as HTMLInputElement | null;
  const productSelect = document.getElementById('rev-product') as HTMLSelectElement | null;
  const cityInput = document.getElementById('rev-city') as HTMLInputElement | null;
  const textInput = document.getElementById('rev-text') as HTMLTextAreaElement | null;
  const ratingInput = document.getElementById('rev-rating') as HTMLInputElement | null;
  const starBtns = document.querySelectorAll<HTMLButtonElement>('.star-pick-btn');
  const starLabel = document.getElementById('star-picker-label');
  const form = document.getElementById('verified-review-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('rev-submit-btn') as HTMLButtonElement | null;
  const statusMsg = document.getElementById('rev-status-msg');

  // Pre-fill from post-delivery link query params (?order=MN-123&name=Arnab&product=Moringa+Powder)
  if (nameInput && params.get('name')) nameInput.value = params.get('name') || '';
  if (orderInput && params.get('order')) orderInput.value = params.get('order') || '';
  if (cityInput && params.get('city')) cityInput.value = params.get('city') || '';

  // Auto-fetch signed-in customer profile if fields are empty
  getCustomerProfile().then((profile) => {
    if (!profile) return;
    if (nameInput && !nameInput.value && profile.full_name) nameInput.value = profile.full_name;
    if (cityInput && !cityInput.value && (profile.city || profile.state)) {
      cityInput.value = [profile.city, profile.state].filter(Boolean).join(', ');
    }
  });
  if (productSelect && params.get('product')) {
    const targetProd = params.get('product') || '';
    const match = Array.from(productSelect.options).find(
      (opt) => opt.value.toLowerCase() === targetProd.toLowerCase()
    );
    if (match) productSelect.value = match.value;
  }

  const ratingLabels: Record<number, string> = {
    1: '1 / 5 — Needs improvement',
    2: '2 / 5 — Below expectations',
    3: '3 / 5 — Good',
    4: '4 / 5 — Very good',
    5: '5 / 5 — Loved it!'
  };

  function paintStars(val: number) {
    starBtns.forEach((btn) => {
      const star = Number(btn.dataset.star || 0);
      btn.classList.toggle('filled', star <= val);
    });
    if (ratingInput) ratingInput.value = String(val);
    if (starLabel) starLabel.textContent = ratingLabels[val] || `${val} / 5`;
  }

  paintStars(5);
  starBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      paintStars(Number(btn.dataset.star || 5));
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!nameInput || !productSelect || !textInput || !ratingInput) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Publishing...';
    }
    if (statusMsg) statusMsg.style.display = 'none';

    const res = await submitReview({
      customer_name: nameInput.value,
      city: cityInput?.value || '',
      order_id: orderInput?.value || '',
      product_name: productSelect.value,
      rating: Number(ratingInput.value),
      review_text: textInput.value,
      source: 'link'
    });

    if (statusMsg) {
      statusMsg.style.display = 'block';
      statusMsg.className = `rev-status-msg ${res.success ? 'success' : 'error'}`;
      statusMsg.textContent = res.success
        ? `${res.message} Redirecting to homepage...`
        : res.message;
    }

    if (res.success) {
      form.reset();
      paintStars(5);
      setTimeout(() => {
        window.location.href = '/#reviews';
      }, 1600);
    } else if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Publish Verified Review';
    }
  });
</script>
