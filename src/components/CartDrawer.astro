<script>
  import { createOrder, cleanProductName, type Order } from '../lib/db';

  // Global Cart Manager with LocalStorage persistence
  interface CartItem {
    id: number | string;
    name: string;
    weight: string;
    price: string;
    originalPrice?: string;
    category?: string;
    quantity: number;
  }

  const STORAGE_KEY = 'manneeds_cart_v1';
  let cart: CartItem[] = [];

  // DOM Elements - Views
  const overlay = document.getElementById('cart-drawer-overlay');
  const viewItems = document.getElementById('cart-view-items');
  const viewCheckout = document.getElementById('cart-view-checkout');
  const viewSuccess = document.getElementById('cart-view-success');

  // View 1 Elements
  const closeBtn = document.getElementById('cart-close-btn');
  const itemsWrap = document.getElementById('cart-items-wrap');
  const emptyState = document.getElementById('cart-empty-state');
  const cartFooter = document.getElementById('cart-footer');
  const countBadge = document.getElementById('cart-items-count');
  const subtotalEl = document.getElementById('cart-subtotal');
  const discountEl = document.getElementById('cart-discount');
  const shippingValEl = document.getElementById('cart-shipping-val');
  const finalTotalEl = document.getElementById('cart-final-total');
  const shippingText = document.getElementById('shipping-text');
  const progressBar = document.getElementById('shipping-progress-bar');
  const checkoutBtn = document.getElementById('checkout-btn');
  const startShopBtn = document.getElementById('start-shopping-btn');
  const toast = document.getElementById('cart-toast');
  const toastMsg = document.getElementById('toast-message');
  const toastViewBtn = document.getElementById('toast-view-btn');

  // View 2 Elements (Checkout)
  const checkoutBackBtn = document.getElementById('checkout-back-btn');
  const checkoutCloseBtn = document.getElementById('checkout-close-btn');
  const checkoutItemsSummary = document.getElementById('checkout-items-summary');
  const checkoutPayableTotal = document.getElementById('checkout-payable-total');
  const btnPayAmount = document.getElementById('btn-pay-amount');
  const checkoutForm = document.getElementById('checkout-form') as HTMLFormElement | null;
  const checkoutError = document.getElementById('checkout-error');
  const placeOrderBtn = document.getElementById('place-order-btn') as HTMLButtonElement | null;
  const checkoutSpinner = document.getElementById('checkout-spinner');
  const payCodLabel = document.getElementById('pay-cod-label');
  const payOnlineLabel = document.getElementById('pay-online-label');

  // View 3 Elements (Success)
  const successOrderId = document.getElementById('success-order-id');
  const successCustomerName = document.getElementById('success-customer-name');
  const successDeliveryAddr = document.getElementById('success-delivery-addr');
  const successPaymentMode = document.getElementById('success-payment-mode');
  const successTotalAmount = document.getElementById('success-total-amount');
  const successContinueBtn = document.getElementById('success-continue-shopping-btn');

  // Load from localStorage
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      cart = JSON.parse(raw).map((i: any) => ({
        ...i,
        name: cleanProductName(i.name)
      }));
    }
  } catch {
    cart = [];
  }

  function saveCart() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    } catch {}
    updateNavbarBadges();
    renderCart();
  }

  function updateNavbarBadges() {
    const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
    document.querySelectorAll('.cart-badge').forEach((badge) => {
      badge.textContent = String(totalCount);
      (badge as HTMLElement).style.display = totalCount > 0 ? '' : 'none';
    });
    if (countBadge) countBadge.textContent = `(${totalCount})`;
  }

  function parsePrice(str: string): number {
    const num = parseInt(str.replace(/\D/g, ''), 10);
    return isNaN(num) ? 0 : num;
  }

  function getIcon(cat: string = ''): string {
    if (cat.includes('Honey')) return '🍯';
    if (cat.includes('Snack')) return '🍿';
    if (cat.includes('Chip')) return '🥭';
    if (cat.includes('Cand')) return '🍬';
    return '🌿';
  }

  function calculateCartTotals() {
    const subtotal = cart.reduce((sum, item) => sum + (parsePrice(item.price) * item.quantity), 0);
    const discount = Math.round(subtotal * 0.15); // 15% flat coupon
    const shipping = subtotal >= 499 ? 0 : (subtotal > 0 ? 49 : 0);
    const finalTotal = Math.max(0, subtotal - discount + shipping);
    return { subtotal, discount, shipping, finalTotal };
  }

  function renderCart() {
    if (!itemsWrap || !emptyState || !cartFooter) return;

    if (cart.length === 0) {
      itemsWrap.innerHTML = '';
      itemsWrap.style.display = 'none';
      emptyState.style.display = 'flex';
      cartFooter.style.display = 'none';
      if (shippingText && progressBar) {
        shippingText.innerHTML = `<span>🚚 Add <strong>₹499</strong> more for <strong>FREE Express Shipping</strong></span>`;
        progressBar.style.width = '0%';
      }
      return;
    }

    itemsWrap.style.display = 'flex';
    emptyState.style.display = 'none';
    cartFooter.style.display = 'block';

    const { subtotal, discount, shipping, finalTotal } = calculateCartTotals();

    itemsWrap.innerHTML = cart.map((item, index) => {
      const icon = getIcon(item.category);
      return `
        <div class="cart-item-row" data-index="${index}">
          <div class="cart-item-thumb">${icon}</div>
          <div class="cart-item-info">
            <h4 class="cart-item-title">${item.name}</h4>
            <span class="cart-item-variant">${item.weight}</span>
            <div class="cart-item-price">${item.price}</div>
          </div>
          <div class="cart-item-actions">
            <div class="qty-stepper">
              <button type="button" class="qty-btn dec-btn" data-index="${index}" aria-label="Decrease quantity">−</button>
              <span class="qty-num">${item.quantity}</span>
              <button type="button" class="qty-btn inc-btn" data-index="${index}" aria-label="Increase quantity">+</button>
            </div>
            <button type="button" class="remove-item-btn" data-index="${index}">Remove</button>
          </div>
        </div>
      `;
    }).join('');

    // Shipping calculations
    const freeThreshold = 499;
    const diff = freeThreshold - subtotal;
    if (shippingText && progressBar) {
      if (diff > 0) {
        shippingText.innerHTML = `<span>🚚 Add <strong>₹${diff}</strong> more for <strong>FREE Express Shipping</strong></span>`;
        const pct = Math.min(100, Math.round((subtotal / freeThreshold) * 100));
        progressBar.style.width = `${pct}%`;
      } else {
        shippingText.innerHTML = `<span>🎉 <strong>Congratulations!</strong> You unlocked FREE Express Shipping!</span>`;
        progressBar.style.width = '100%';
      }
    }

    if (subtotalEl) subtotalEl.textContent = `₹${subtotal}`;
    if (discountEl) discountEl.textContent = `-₹${discount}`;
    if (shippingValEl) shippingValEl.textContent = shipping === 0 ? 'FREE' : `₹${shipping}`;
    if (finalTotalEl) finalTotalEl.textContent = `₹${finalTotal}`;

    // Bind item steppers
    itemsWrap.querySelectorAll('.inc-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          cart[idx].quantity += 1;
          saveCart();
        }
      });
    });

    itemsWrap.querySelectorAll('.dec-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          cart[idx].quantity -= 1;
          if (cart[idx].quantity <= 0) cart.splice(idx, 1);
          saveCart();
        }
      });
    });

    itemsWrap.querySelectorAll('.remove-item-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        cart.splice(idx, 1);
        saveCart();
      });
    });
  }

  // Slide Transitions
  function switchView(view: 'items' | 'checkout' | 'success') {
    if (!viewItems || !viewCheckout || !viewSuccess) return;

    viewItems.style.display = view === 'items' ? 'flex' : 'none';
    viewCheckout.style.display = view === 'checkout' ? 'flex' : 'none';
    viewSuccess.style.display = view === 'success' ? 'flex' : 'none';

    if (view === 'checkout') {
      const { finalTotal } = calculateCartTotals();
      const count = cart.reduce((s, i) => s + i.quantity, 0);
      if (checkoutItemsSummary) checkoutItemsSummary.textContent = `${count} item(s)`;
      if (checkoutPayableTotal) checkoutPayableTotal.textContent = `₹${finalTotal}`;
      if (btnPayAmount) btnPayAmount.textContent = `₹${finalTotal}`;
      if (checkoutError) checkoutError.style.display = 'none';
    }
  }

  function openCart() {
    if (overlay) {
      overlay.classList.add('active');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      switchView('items');
      renderCart();
    }
  }

  function closeCart() {
    if (overlay) {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => switchView('items'), 350);
    }
  }

  let toastTimer: any = null;
  function showToast(msg: string) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.classList.add('active');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove('active');
    }, 3800);
  }

  // Global Cart API on window
  (window as any).manneedsCart = {
    open: openCart,
    close: closeCart,
    showToast: showToast,
    getCart: () => cart,
    add: (item: { id: number | string; name: string; weight: string; price: string; originalPrice?: string; category?: string }) => {
      const cleanName = cleanProductName(item.name);
      const cleanedItem = { ...item, name: cleanName };
      const existing = cart.find((i) => i.id === item.id && i.weight === item.weight);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ ...cleanedItem, quantity: 1 });
      }
      saveCart();
      showToast(`Added ${cleanName} (${item.weight})!`);
      openCart();
    }
  };

  // Listeners
  if (closeBtn) closeBtn.addEventListener('click', closeCart);
  if (checkoutCloseBtn) checkoutCloseBtn.addEventListener('click', closeCart);
  if (checkoutBackBtn) checkoutBackBtn.addEventListener('click', () => switchView('items'));

  if (overlay) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeCart();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCart();
  });

  // Open cart from any .cart-btn or #cart-btn
  document.querySelectorAll('.cart-btn, #cart-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openCart();
    });
  });

  if (toastViewBtn) {
    toastViewBtn.addEventListener('click', () => {
      if (toast) toast.classList.remove('active');
      openCart();
    });
  }

  if (startShopBtn) {
    startShopBtn.addEventListener('click', () => {
      closeCart();
      document.getElementById('bestsellers')?.scrollIntoView({ behavior: 'smooth' });
    });
  }

  // Proceed to Checkout Button Click
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Your box is empty! Add products to proceed.');
        return;
      }
      switchView('checkout');
    });
  }

  // Payment radio option styling toggle
  const paymentRadios = document.querySelectorAll<HTMLInputElement>('input[name="payment_method"]');
  paymentRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      if (payCodLabel && payOnlineLabel) {
        payCodLabel.classList.toggle('active', radio.value === 'cod' && radio.checked);
        payOnlineLabel.classList.toggle('active', radio.value === 'online_upi' && radio.checked);
      }
    });
  });

  // Checkout Form Submission (Calls createOrder -> logs into sold_items and auto-deducts inventory!)
  if (checkoutForm) {
    checkoutForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!placeOrderBtn) return;

      const formData = new FormData(checkoutForm);
      const name = (formData.get('customer_name') as string || '').trim();
      const phone = (formData.get('customer_phone') as string || '').trim();
      const email = (formData.get('customer_email') as string || '').trim();
      const address = (formData.get('shipping_address') as string || '').trim();
      const pincode = (formData.get('pincode') as string || '').trim();
      const city = (formData.get('city') as string || '').trim();
      const state = (formData.get('state') as string || '').trim();
      const paymentMethod = (formData.get('payment_method') as any) || 'cod';

      // Validation
      if (!name || !phone || !address || !pincode || !city || !state) {
        if (checkoutError) {
          checkoutError.textContent = 'Please fill out all required delivery fields.';
          checkoutError.style.display = 'block';
        }
        return;
      }

      if (!/^[6-9]\d{9}$/.test(phone)) {
        if (checkoutError) {
          checkoutError.textContent = 'Please enter a valid 10-digit Indian mobile number.';
          checkoutError.style.display = 'block';
        }
        return;
      }

      if (!/^\d{6}$/.test(pincode)) {
        if (checkoutError) {
          checkoutError.textContent = 'Please enter a valid 6-digit postal pincode.';
          checkoutError.style.display = 'block';
        }
        return;
      }

      // UI: Loading State
      if (checkoutError) checkoutError.style.display = 'none';
      placeOrderBtn.disabled = true;
      const btnText = placeOrderBtn.querySelector('.btn-text') as HTMLElement;
      if (btnText) btnText.style.display = 'none';
      if (checkoutSpinner) checkoutSpinner.style.display = 'flex';

      const { subtotal, discount, shipping, finalTotal } = calculateCartTotals();

      const orderPayload: Order = {
        customer_name: name,
        customer_phone: phone,
        customer_email: email || undefined,
        shipping_address: address,
        city: city,
        state: state,
        pincode: pincode,
        payment_method: paymentMethod,
        payment_status: paymentMethod === 'cod' ? 'cod_pending' : 'paid',
        subtotal: subtotal,
        discount_amount: discount,
        discount_code: 'MANNEEDS15',
        shipping_fee: shipping,
        total_amount: finalTotal,
        items: cart.map((i) => ({
          id: i.id,
          name: i.name,
          weight: i.weight,
          price: i.price,
          originalPrice: i.originalPrice,
          quantity: i.quantity
        })),
        status: 'confirmed'
      };

      try {
        const res = await createOrder(orderPayload);
        if (!res.success) {
          throw new Error(res.message);
        }

        // Populate Success View
        if (successOrderId) successOrderId.textContent = res.orderId || 'MN-849201';
        if (successCustomerName) successCustomerName.textContent = `${name} (+91 ${phone})`;
        if (successDeliveryAddr) successDeliveryAddr.textContent = `${address}, ${city}, ${state} - ${pincode}`;
        if (successPaymentMode) {
          successPaymentMode.textContent = paymentMethod === 'cod' 
            ? 'Cash on Delivery (Pay at doorstep)' 
            : 'Instant UPI / Online';
        }
        if (successTotalAmount) successTotalAmount.textContent = `₹${finalTotal}`;

        // Clear Cart
        cart = [];
        saveCart();
        checkoutForm.reset();

        // Switch to Success View
        switchView('success');
      } catch (err: any) {
        if (checkoutError) {
          checkoutError.textContent = err?.message || 'Failed to place order. Please try again.';
          checkoutError.style.display = 'block';
        }
      } finally {
        placeOrderBtn.disabled = false;
        if (btnText) btnText.style.display = '';
        if (checkoutSpinner) checkoutSpinner.style.display = 'none';
      }
    });
  }

  // Success view actions
  if (successContinueBtn) {
    successContinueBtn.addEventListener('click', () => {
      closeCart();
    });
  }

  // Initialize
  updateNavbarBadges();
  renderCart();
</script>
