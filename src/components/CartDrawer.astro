---
// CartDrawer.astro - High-conversion, slide-over cart drawer
---

<!-- Cart Drawer Overlay & Panel -->
<div class="cart-drawer-overlay" id="cart-drawer-overlay" aria-hidden="true">
  <div class="cart-drawer-panel" id="cart-drawer-panel" role="dialog" aria-modal="true" aria-label="Your ManNeeds Shopping Cart">
    <!-- Drawer Header -->
    <div class="cart-header">
      <div class="cart-title-wrap">
        <span class="cart-header-icon">🛍️</span>
        <h3 class="cart-header-title">Your ManNeeds Box</h3>
        <span class="cart-header-count" id="cart-items-count">(0)</span>
      </div>
      <button type="button" class="cart-close-btn" id="cart-close-btn" aria-label="Close Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Free Shipping Progress Tracker -->
    <div class="free-shipping-card" id="free-shipping-card">
      <div class="shipping-text" id="shipping-text">
        <span>🚚 Add <strong>₹499</strong> more for <strong>FREE Express Shipping</strong></span>
      </div>
      <div class="shipping-progress-track">
        <div class="shipping-progress-bar" id="shipping-progress-bar" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Scrollable Items List -->
    <div class="cart-items-wrap" id="cart-items-wrap">
      <!-- Items dynamically rendered by JS -->
    </div>

    <!-- Empty State -->
    <div class="cart-empty-state" id="cart-empty-state" style="display: none;">
      <div class="empty-icon-wrap">🍿</div>
      <h4>Your Box is Empty!</h4>
      <p>Clean roasted snacks, wild honey & botanical powders are waiting for you.</p>
      <button type="button" class="btn btn-primary start-shopping-btn" id="start-shopping-btn">
        Explore 23 Products →
      </button>
    </div>

    <!-- Drawer Footer (Subtotal, Coupon, Checkout) -->
    <div class="cart-footer" id="cart-footer">
      <!-- Coupon Strip -->
      <div class="cart-coupon-strip">
        <span class="coupon-badge">MANNEEDS15</span>
        <span class="coupon-text">15% OFF Applied at checkout</span>
      </div>

      <!-- Price Breakdown -->
      <div class="cart-totals">
        <div class="total-row subtotal-row">
          <span>Subtotal</span>
          <span id="cart-subtotal">₹0</span>
        </div>
        <div class="total-row discount-row">
          <span>Tribe Discount (15% OFF)</span>
          <span class="discount-val" id="cart-discount">-₹0</span>
        </div>
        <div class="total-row final-row">
          <strong>Total to Pay</strong>
          <strong class="final-price" id="cart-final-total">₹0</strong>
        </div>
      </div>

      <!-- Action Buttons -->
      <button type="button" class="btn btn-primary checkout-btn" id="checkout-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Proceed to Secure Checkout</span>
      </button>

      <div class="cart-trust-footer">
        <span>🔒 100% Encrypted & Safe Checkout</span>
        <span>•</span>
        <span>⚡ 48-Hour Delivery</span>
      </div>
    </div>
  </div>
</div>

<!-- Floating In-App Toast Notification -->
<div class="cart-toast" id="cart-toast" role="status" aria-live="polite">
  <div class="toast-content">
    <span class="toast-icon">✓</span>
    <span class="toast-message" id="toast-message">Added to your box!</span>
  </div>
  <button type="button" class="toast-btn" id="toast-view-btn">View Box →</button>
</div>

<style is:global>
  /* Cart Drawer Overlay */
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(17, 24, 39, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  }

  .cart-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* Cart Drawer Panel */
  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background: #FFFFFF;
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cart-drawer-overlay.active .cart-drawer-panel {
    transform: translateX(0);
  }

  /* Header */
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: #FFFFFF;
  }

  .cart-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-header-icon {
    font-size: 1.25rem;
  }

  .cart-header-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .cart-header-count {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--mn-orange);
  }

  .cart-close-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: #F9FAFB;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cart-close-btn:hover {
    background: #FFF7ED;
    color: var(--mn-orange);
    border-color: var(--mn-orange);
    transform: rotate(90deg);
  }

  /* Free Shipping Bar */
  .free-shipping-card {
    padding: 0.85rem 1.5rem;
    background: #F0FDF4;
    border-bottom: 1px solid #DCFCE7;
  }

  .shipping-text {
    font-size: 0.82rem;
    color: #166534;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .shipping-progress-track {
    width: 100%;
    height: 6px;
    background: #DCFCE7;
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .shipping-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #10B981, #059669);
    border-radius: var(--radius-full);
    transition: width 0.4s ease;
  }

  /* Scrollable Items */
  .cart-items-wrap {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    -webkit-overflow-scrolling: touch;
  }

  .cart-item-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
  }

  .cart-item-row:hover {
    border-color: rgba(255, 104, 56, 0.35);
  }

  .cart-item-thumb {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: #FFF7ED;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .cart-item-info {
    flex: 1;
    min-width: 0;
  }

  .cart-item-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.2rem;
  }

  .cart-item-variant {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mn-orange);
    background: #FFF7ED;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.35rem;
  }

  .cart-item-price {
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .cart-item-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .qty-stepper {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-full);
    overflow: hidden;
    background: #FFFFFF;
  }

  .qty-btn {
    width: 26px;
    height: 26px;
    background: transparent;
    border: none;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
  }

  .qty-btn:hover {
    background: #F3F4F6;
    color: var(--mn-orange);
  }

  .qty-num {
    min-width: 20px;
    text-align: center;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .remove-item-btn {
    background: none;
    border: none;
    font-size: 0.72rem;
    font-weight: 600;
    color: #9CA3AF;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .remove-item-btn:hover {
    color: #DC2626;
  }

  /* Empty State */
  .cart-empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    text-align: center;
  }

  .empty-icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    background: #FFF7ED;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    margin-bottom: 1.25rem;
  }

  .cart-empty-state h4 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .cart-empty-state p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    max-width: 260px;
  }

  .start-shopping-btn {
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
  }

  /* Footer */
  .cart-footer {
    border-top: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
    background: #FAFAFA;
  }

  .cart-coupon-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    background: #FEF3C7;
    border: 1px dashed #F59E0B;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }

  .coupon-badge {
    font-weight: 800;
    color: #92400E;
    letter-spacing: 0.05em;
  }

  .coupon-text {
    font-weight: 600;
    color: #B45309;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .total-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .discount-row {
    color: #059669;
    font-weight: 700;
  }

  .final-row {
    font-size: 1.15rem;
    color: var(--text-primary);
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-subtle);
  }

  .final-price {
    font-family: var(--font-heading);
    color: var(--mn-orange);
    font-size: 1.35rem;
    font-weight: 900;
  }

  .checkout-btn {
    width: 100%;
    padding: 0.9rem;
    font-size: 1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow: 0 10px 25px -5px rgba(255, 104, 56, 0.4);
  }

  .cart-trust-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-top: 0.85rem;
  }

  /* In-App Toast */
  .cart-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 10000;
    background: #111827;
    color: #FFFFFF;
    border-radius: var(--radius-md);
    padding: 0.75rem 1.15rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    transform: translateY(120%);
    opacity: 0;
    visibility: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cart-toast.active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .toast-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toast-icon {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    background: #10B981;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 900;
  }

  .toast-message {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .toast-btn {
    background: var(--mn-orange);
    color: #FFFFFF;
    border: none;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .toast-btn:hover {
    background: var(--mn-orange-hover);
  }
</style>

<script>
  // Global Cart Manager with LocalStorage persistence
  interface CartItem {
    id: number | string;
    name: string;
    weight: string;
    price: string;
    originalPrice?: string;
    category?: string;
    quantity: number;
  }

  const STORAGE_KEY = 'manneeds_cart_v1';
  let cart: CartItem[] = [];

  // Elements
  const overlay = document.getElementById('cart-drawer-overlay');
  const closeBtn = document.getElementById('cart-close-btn');
  const itemsWrap = document.getElementById('cart-items-wrap');
  const emptyState = document.getElementById('cart-empty-state');
  const cartFooter = document.getElementById('cart-footer');
  const countBadge = document.getElementById('cart-items-count');
  const subtotalEl = document.getElementById('cart-subtotal');
  const discountEl = document.getElementById('cart-discount');
  const finalTotalEl = document.getElementById('cart-final-total');
  const shippingText = document.getElementById('shipping-text');
  const progressBar = document.getElementById('shipping-progress-bar');
  const checkoutBtn = document.getElementById('checkout-btn');
  const startShopBtn = document.getElementById('start-shopping-btn');
  const toast = document.getElementById('cart-toast');
  const toastMsg = document.getElementById('toast-message');
  const toastViewBtn = document.getElementById('toast-view-btn');

  // Load from localStorage
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) cart = JSON.parse(raw);
  } catch {
    cart = [];
  }

  function saveCart() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    } catch {}
    updateNavbarBadges();
    renderCart();
  }

  function updateNavbarBadges() {
    const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
    document.querySelectorAll('.cart-badge').forEach((badge) => {
      badge.textContent = String(totalCount);
      (badge as HTMLElement).style.display = totalCount > 0 ? '' : 'none';
    });
    if (countBadge) countBadge.textContent = `(${totalCount})`;
  }

  function parsePrice(str: string): number {
    const num = parseInt(str.replace(/\D/g, ''), 10);
    return isNaN(num) ? 0 : num;
  }

  function getIcon(cat: string = ''): string {
    if (cat.includes('Honey')) return '🍯';
    if (cat.includes('Snack')) return '🍿';
    if (cat.includes('Chip')) return '🥭';
    if (cat.includes('Cand')) return '🍬';
    return '🌿';
  }

  function renderCart() {
    if (!itemsWrap || !emptyState || !cartFooter) return;

    if (cart.length === 0) {
      itemsWrap.innerHTML = '';
      itemsWrap.style.display = 'none';
      emptyState.style.display = 'flex';
      cartFooter.style.display = 'none';
      if (shippingText && progressBar) {
        shippingText.innerHTML = `<span>🚚 Add <strong>₹499</strong> more for <strong>FREE Express Shipping</strong></span>`;
        progressBar.style.width = '0%';
      }
      return;
    }

    itemsWrap.style.display = 'flex';
    emptyState.style.display = 'none';
    cartFooter.style.display = 'block';

    let subtotal = 0;

    itemsWrap.innerHTML = cart.map((item, index) => {
      const priceNum = parsePrice(item.price);
      subtotal += priceNum * item.quantity;
      const icon = getIcon(item.category);

      return `
        <div class="cart-item-row" data-index="${index}">
          <div class="cart-item-thumb">${icon}</div>
          <div class="cart-item-info">
            <h4 class="cart-item-title">${item.name}</h4>
            <span class="cart-item-variant">${item.weight}</span>
            <div class="cart-item-price">${item.price}</div>
          </div>
          <div class="cart-item-actions">
            <div class="qty-stepper">
              <button type="button" class="qty-btn dec-btn" data-index="${index}" aria-label="Decrease quantity">−</button>
              <span class="qty-num">${item.quantity}</span>
              <button type="button" class="qty-btn inc-btn" data-index="${index}" aria-label="Increase quantity">+</button>
            </div>
            <button type="button" class="remove-item-btn" data-index="${index}">Remove</button>
          </div>
        </div>
      `;
    }).join('');

    // Shipping calculations
    const freeThreshold = 499;
    const diff = freeThreshold - subtotal;
    if (shippingText && progressBar) {
      if (diff > 0) {
        shippingText.innerHTML = `<span>🚚 Add <strong>₹${diff}</strong> more for <strong>FREE Express Shipping</strong></span>`;
        const pct = Math.min(100, Math.round((subtotal / freeThreshold) * 100));
        progressBar.style.width = `${pct}%`;
      } else {
        shippingText.innerHTML = `<span>🎉 <strong>Congratulations!</strong> You unlocked FREE Express Shipping!</span>`;
        progressBar.style.width = '100%';
      }
    }

    // Discount & Totals (15% Flat off)
    const discount = Math.round(subtotal * 0.15);
    const finalTotal = subtotal - discount;

    if (subtotalEl) subtotalEl.textContent = `₹${subtotal}`;
    if (discountEl) discountEl.textContent = `-₹${discount}`;
    if (finalTotalEl) finalTotalEl.textContent = `₹${finalTotal}`;

    // Bind item steppers
    itemsWrap.querySelectorAll('.inc-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          cart[idx].quantity += 1;
          saveCart();
        }
      });
    });

    itemsWrap.querySelectorAll('.dec-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          cart[idx].quantity -= 1;
          if (cart[idx].quantity <= 0) cart.splice(idx, 1);
          saveCart();
        }
      });
    });

    itemsWrap.querySelectorAll('.remove-item-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        cart.splice(idx, 1);
        saveCart();
      });
    });
  }

  function openCart() {
    if (overlay) {
      overlay.classList.add('active');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      renderCart();
    }
  }

  function closeCart() {
    if (overlay) {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  let toastTimer: any = null;
  function showToast(msg: string) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.classList.add('active');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove('active');
    }, 3800);
  }

  // Global Cart API on window
  (window as any).manneedsCart = {
    open: openCart,
    close: closeCart,
    showToast: showToast,
    getCart: () => cart,
    add: (item: { id: number | string; name: string; weight: string; price: string; originalPrice?: string; category?: string }) => {
      const existing = cart.find((i) => i.id === item.id && i.weight === item.weight);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ ...item, quantity: 1 });
      }
      saveCart();
      showToast(`Added ${item.name} (${item.weight})!`);
      openCart();
    }
  };

  // Listeners
  if (closeBtn) closeBtn.addEventListener('click', closeCart);
  if (overlay) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeCart();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCart();
  });

  // Open cart from any .cart-btn or #cart-btn
  document.querySelectorAll('.cart-btn, #cart-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openCart();
    });
  });

  if (toastViewBtn) {
    toastViewBtn.addEventListener('click', () => {
      if (toast) toast.classList.remove('active');
      openCart();
    });
  }

  if (startShopBtn) {
    startShopBtn.addEventListener('click', () => {
      closeCart();
      document.getElementById('bestsellers')?.scrollIntoView({ behavior: 'smooth' });
    });
  }

  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', () => {
      const finalPrice = finalTotalEl?.textContent || '₹0';
      alert(`Proceeding to checkout with ${cart.length} item(s) • Total: ${finalPrice}\nCoupon MANNEEDS15 Applied (15% OFF)!\nThank you for choosing ManNeeds clean nutrition.`);
    });
  }

  // Initialize
  updateNavbarBadges();
  renderCart();
</script>
