---
// CartDrawer.astro - High-conversion, slide-over cart drawer & Indian D2C checkout
---

<!-- Cart Drawer Overlay & Panel -->
<div class="cart-drawer-overlay" id="cart-drawer-overlay" aria-hidden="true">
  <div class="cart-drawer-panel" id="cart-drawer-panel" role="dialog" aria-modal="true" aria-label="Your Shopping Cart">
    
    <!-- ======================================================== -->
    <!-- VIEW 1: CART ITEMS & UPSELLS                             -->
    <!-- ======================================================== -->
    <div class="cart-slide-view" id="cart-view-items">
      <!-- Drawer Header -->
      <div class="cart-header">
        <div class="cart-title-wrap">
          <span class="cart-header-icon">🛍️</span>
          <h3 class="cart-header-title">Your Shopping Box</h3>
          <span class="cart-header-count" id="cart-items-count">(0)</span>
        </div>
        <button type="button" class="cart-close-btn" id="cart-close-btn" aria-label="Close Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Free Shipping Progress Tracker -->
      <div class="free-shipping-card" id="free-shipping-card">
        <div class="shipping-text" id="shipping-text">
          <span>🚚 Add <strong>₹499</strong> more for <strong>FREE Express Shipping</strong></span>
        </div>
        <div class="shipping-progress-track">
          <div class="shipping-progress-bar" id="shipping-progress-bar" style="width: 0%;"></div>
        </div>
      </div>

      <!-- Scrollable Items List -->
      <div class="cart-items-wrap" id="cart-items-wrap">
        <!-- Items dynamically rendered by JS -->
      </div>

      <!-- Empty State -->
      <div class="cart-empty-state" id="cart-empty-state" style="display: none;">
        <div class="empty-icon-wrap">🍿</div>
        <h4>Your Box is Empty!</h4>
        <p>Clean roasted snacks, wild honey & botanical powders are waiting for you.</p>
        <button type="button" class="btn btn-primary start-shopping-btn" id="start-shopping-btn">
          Explore 23 Products →
        </button>
      </div>

      <!-- Drawer Footer (Subtotal, Coupon, Checkout) -->
      <div class="cart-footer" id="cart-footer">
        <!-- Coupon Strip -->
        <div class="cart-coupon-strip">
          <span class="coupon-badge">MANNEEDS15</span>
          <span class="coupon-text">15% OFF Applied at checkout</span>
        </div>

        <!-- Price Breakdown -->
        <div class="cart-totals">
          <div class="total-row subtotal-row">
            <span>Subtotal</span>
            <span id="cart-subtotal">₹0</span>
          </div>
          <div class="total-row discount-row">
            <span>Tribe Discount (15% OFF)</span>
            <span class="discount-val" id="cart-discount">-₹0</span>
          </div>
          <div class="total-row shipping-row">
            <span>Express Delivery</span>
            <span class="shipping-val" id="cart-shipping-val">FREE</span>
          </div>
          <div class="total-row final-row">
            <strong>Total to Pay</strong>
            <strong class="final-price" id="cart-final-total">₹0</strong>
          </div>
        </div>

        <!-- Action Buttons -->
        <button type="button" class="btn btn-primary checkout-btn" id="checkout-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Proceed to Secure Checkout</span>
        </button>

        <div class="cart-trust-footer">
          <span>🔒 100% Encrypted & Safe Checkout</span>
          <span>•</span>
          <span>⚡ 48-Hour Delivery</span>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- VIEW 2: CHECKOUT (DELIVERY & PAYMENT DETAILS)            -->
    <!-- ======================================================== -->
    <div class="cart-slide-view" id="cart-view-checkout" style="display: none;">
      <!-- Header with back button -->
      <div class="cart-header">
        <button type="button" class="checkout-back-btn" id="checkout-back-btn" aria-label="Back to Cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Cart</span>
        </button>
        <h3 class="cart-header-title">Delivery & Payment</h3>
        <button type="button" class="cart-close-btn" id="checkout-close-btn" aria-label="Close Checkout">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Scrollable Checkout Body -->
      <div class="checkout-scroll-body">
        <!-- Order Summary Strip -->
        <div class="checkout-order-strip">
          <div class="strip-details">
            <span class="strip-qty" id="checkout-items-summary">0 items</span>
            <span class="strip-divider">•</span>
            <span class="strip-discount">MANNEEDS15 (15% OFF)</span>
          </div>
          <div class="strip-total" id="checkout-payable-total">₹0</div>
        </div>

        <!-- Checkout Form -->
        <form id="checkout-form" class="checkout-form" autocomplete="on">
          <!-- Contact Info -->
          <div class="form-section">
            <div class="form-section-title">
              <span class="section-num">1</span>
              <span>Delivery Details</span>
            </div>

            <div class="form-group">
              <label for="checkout-name">Full Name <span class="req">*</span></label>
              <input type="text" id="checkout-name" name="customer_name" required placeholder="e.g. Rahul Sharma" autocomplete="name" />
            </div>

            <div class="form-row">
              <div class="form-group flex-2">
                <label for="checkout-phone">Mobile Number <span class="req">*</span></label>
                <div class="phone-input-wrap">
                  <span class="country-prefix">+91</span>
                  <input type="tel" id="checkout-phone" name="customer_phone" required pattern="[6-9][0-9]{9}" maxlength="10" placeholder="10-digit number" autocomplete="tel" inputmode="numeric" />
                </div>
              </div>
              <div class="form-group flex-2">
                <label for="checkout-email">Email <span class="opt">(for bill)</span></label>
                <input type="email" id="checkout-email" name="customer_email" placeholder="rahul@example.com" autocomplete="email" />
              </div>
            </div>

            <div class="form-group">
              <label for="checkout-address">Delivery Address (House/Flat, Street, Area) <span class="req">*</span></label>
              <textarea id="checkout-address" name="shipping_address" required rows="2" placeholder="e.g. Flat 302, Palm Grove Apt, Indiranagar" autocomplete="street-address"></textarea>
            </div>

            <div class="form-row">
              <div class="form-group flex-1">
                <label for="checkout-pincode">Pincode <span class="req">*</span></label>
                <input type="text" id="checkout-pincode" name="pincode" required pattern="[0-9]{6}" maxlength="6" placeholder="e.g. 560038" autocomplete="postal-code" inputmode="numeric" />
              </div>
              <div class="form-group flex-2">
                <label for="checkout-city">City <span class="req">*</span></label>
                <input type="text" id="checkout-city" name="city" required placeholder="e.g. Bengaluru" autocomplete="address-level2" />
              </div>
              <div class="form-group flex-2">
                <label for="checkout-state">State <span class="req">*</span></label>
                <input type="text" id="checkout-state" name="state" required placeholder="e.g. Karnataka" autocomplete="address-level1" />
              </div>
            </div>
          </div>

          <!-- Payment Method -->
          <div class="form-section">
            <div class="form-section-title">
              <span class="section-num">2</span>
              <span>Payment Mode</span>
            </div>

            <div class="payment-options-grid">
              <label class="payment-card active" id="pay-cod-label">
                <input type="radio" name="payment_method" value="cod" checked />
                <div class="payment-card-body">
                  <div class="payment-card-header">
                    <span class="payment-icon">💵</span>
                    <span class="payment-title">Cash on Delivery (COD)</span>
                    <span class="payment-badge">Standard</span>
                  </div>
                  <p class="payment-desc">Pay cash or scan UPI when courier delivers to your door.</p>
                </div>
              </label>

              <label class="payment-card" id="pay-online-label">
                <input type="radio" name="payment_method" value="online_upi" />
                <div class="payment-card-body">
                  <div class="payment-card-header">
                    <span class="payment-icon">📱</span>
                    <span class="payment-title">Instant UPI & Cards</span>
                    <span class="payment-badge-online">Zero Contact</span>
                  </div>
                  <p class="payment-desc">Google Pay, PhonePe, Paytm, or Credit/Debit Cards.</p>
                </div>
              </label>
            </div>
          </div>

          <!-- Assurances -->
          <div class="checkout-assurances">
            <div class="assurance-item">
              <span class="ai-icon">⚡</span>
              <span>48h Express Dispatch</span>
            </div>
            <div class="assurance-item">
              <span class="ai-icon">📊</span>
              <span>Live 3-Table Inventory Sync</span>
            </div>
            <div class="assurance-item">
              <span class="ai-icon">🔒</span>
              <span>256-Bit SSL Encrypted</span>
            </div>
          </div>

          <!-- Error Alert (hidden by default) -->
          <div class="checkout-error" id="checkout-error" style="display: none;"></div>

          <!-- Place Order Button -->
          <div class="checkout-submit-wrap">
            <button type="submit" class="btn btn-primary place-order-btn" id="place-order-btn">
              <span class="btn-text">Confirm Order • <span id="btn-pay-amount">₹0</span></span>
              <span class="btn-spinner" id="checkout-spinner" style="display: none;">
                <svg class="spin-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                </svg>
                <span>Processing Order...</span>
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- VIEW 3: ORDER SUCCESS & RECEIPT                          -->
    <!-- ======================================================== -->
    <div class="cart-slide-view" id="cart-view-success" style="display: none;">
      <div class="success-screen-inner">
        <div class="success-icon-bounce">🎉</div>
        <h3 class="success-title">Order Confirmed!</h3>
        <p class="success-subtitle">Thank you for ordering clean nutrition essentials.</p>

        <div class="success-order-badge">
          <span>Order ID: </span>
          <strong id="success-order-id">MN-894201</strong>
        </div>

        <div class="success-card">
          <div class="success-card-row">
            <span class="sc-label">Delivery Estimate:</span>
            <span class="sc-val"><strong>2–4 Business Days (Express)</strong></span>
          </div>
          <div class="success-card-row">
            <span class="sc-label">Customer:</span>
            <span class="sc-val" id="success-customer-name">-</span>
          </div>
          <div class="success-card-row">
            <span class="sc-label">Delivery To:</span>
            <span class="sc-val" id="success-delivery-addr">-</span>
          </div>
          <div class="success-card-row">
            <span class="sc-label">Payment Mode:</span>
            <span class="sc-val" id="success-payment-mode">Cash on Delivery</span>
          </div>
          <div class="success-card-row total-highlight">
            <span class="sc-label">Total Paid / Payable:</span>
            <span class="sc-val" id="success-total-amount">₹0</span>
          </div>
        </div>

        <!-- Inventory Sync Alert -->
        <div class="inventory-sync-alert">
          <div class="isa-icon">✅</div>
          <div class="isa-text">
            <strong>Supabase 3-Table Inventory Realtime Sync:</strong>
            <p>Your purchased items were logged into <code>public.sold_items</code>. Trigger automatically recalculated available stock in <code>products.stock_quantity</code>.</p>
          </div>
        </div>

        <div class="success-actions">
          <button type="button" class="btn btn-primary" id="success-continue-shopping-btn" style="width: 100%;">
            Continue Shopping Clean Foods →
          </button>
          <a href="/inventory" class="btn-link-inventory" id="success-view-inventory-link">
            Inspect in Live Inventory Dashboard 📊
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Floating In-App Toast Notification -->
<div class="cart-toast" id="cart-toast" role="status" aria-live="polite">
  <div class="toast-content">
    <span class="toast-icon">✓</span>
    <span class="toast-message" id="toast-message">Added to your box!</span>
  </div>
  <button type="button" class="toast-btn" id="toast-view-btn">View Box →</button>
</div>

<style is:global>
  /* Cart Drawer Overlay */
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(17, 24, 39, 0.5);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  }

  .cart-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* Cart Drawer Panel */
  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 480px;
    background: #FFFFFF;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .cart-drawer-overlay.active .cart-drawer-panel {
    transform: translateX(0);
  }

  /* Slide Views */
  .cart-slide-view {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  /* Header */
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.35rem;
    border-bottom: 1px solid var(--border-subtle);
    background: #FFFFFF;
    flex-shrink: 0;
  }

  .cart-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-header-icon {
    font-size: 1.25rem;
  }

  .cart-header-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .cart-header-count {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--mn-orange);
  }

  .checkout-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: #F9FAFB;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .checkout-back-btn:hover {
    background: #F3F4F6;
    color: var(--text-primary);
    border-color: #D1D5DB;
  }

  .cart-close-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: #F9FAFB;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cart-close-btn:hover {
    background: var(--bg-tint-orange);
    color: var(--mn-cta);
    border-color: var(--border-accent);
    transform: rotate(90deg);
  }

  /* Free Shipping Bar */
  .free-shipping-card {
    padding: 0.85rem 1.35rem;
    background: var(--bg-tint-green);
    border-bottom: 1px solid var(--border-green);
    flex-shrink: 0;
  }

  .shipping-text {
    font-size: 0.82rem;
    color: var(--mn-primary);
    margin-bottom: 0.45rem;
    font-weight: 600;
  }

  .shipping-progress-track {
    width: 100%;
    height: 6px;
    background: rgba(30, 70, 32, 0.12);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .shipping-progress-bar {
    height: 100%;
    background: var(--gradient-primary);
    border-radius: var(--radius-full);
    transition: width 0.4s ease;
  }

  /* Scrollable Items List */
  .cart-items-wrap {
    flex: 1;
    overflow-y: auto;
    padding: 1.15rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cart-item-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem;
    border-radius: var(--radius-md);
    background: #F9FAFB;
    border: 1px solid var(--border-subtle);
    transition: border-color var(--transition-fast);
  }

  .cart-item-row:hover {
    border-color: #D1D5DB;
  }

  .cart-item-thumb {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .cart-item-info {
    flex: 1;
    min-width: 0;
  }

  .cart-item-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.25;
    margin-bottom: 0.2rem;
  }

  .cart-item-variant {
    font-size: 0.76rem;
    color: var(--text-muted);
    background: #E5E7EB;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .cart-item-price {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--mn-cta);
    margin-top: 0.25rem;
  }

  .cart-item-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-subtle);
    background: #FFFFFF;
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .qty-btn {
    width: 26px;
    height: 26px;
    border: none;
    background: transparent;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
  }

  .qty-btn:hover {
    background: #F3F4F6;
  }

  .qty-num {
    padding: 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .remove-item-btn {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    transition: color var(--transition-fast);
  }

  .remove-item-btn:hover {
    color: #DC2626;
  }

  /* Empty State */
  .cart-empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .empty-icon-wrap {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    animation: floatBounce 2.5s infinite ease-in-out;
  }

  @keyframes floatBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .cart-empty-state h4 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .cart-empty-state p {
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 260px;
    margin-bottom: 1.5rem;
    line-height: 1.45;
  }

  /* Footer */
  .cart-footer {
    padding: 1.15rem 1.35rem;
    border-top: 1px solid var(--border-subtle);
    background: #FFFFFF;
    flex-shrink: 0;
  }

  .cart-coupon-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    background: #FEF3C7;
    border: 1px dashed #F59E0B;
    border-radius: var(--radius-sm);
    margin-bottom: 0.9rem;
    font-size: 0.8rem;
  }

  .coupon-badge {
    font-weight: 800;
    color: #92400E;
    letter-spacing: 0.05em;
  }

  .coupon-text {
    font-weight: 600;
    color: #B45309;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.15rem;
  }

  .total-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .discount-row {
    color: #059669;
    font-weight: 700;
  }

  .shipping-row .shipping-val {
    color: #059669;
    font-weight: 700;
  }

  .final-row {
    font-size: 1.15rem;
    color: var(--text-primary);
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .final-price {
    font-family: var(--font-heading);
    color: var(--mn-cta);
    font-size: 1.35rem;
    font-weight: 900;
  }

  .checkout-btn {
    width: 100%;
    padding: 0.9rem;
    font-size: 1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--gradient-primary);
    box-shadow: var(--shadow-cta);
    border-radius: var(--radius-md);
  }

  .cart-trust-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-top: 0.75rem;
  }

  /* ======================================================== */
  /* CHECKOUT VIEW STYLES                                     */
  /* ======================================================== */
  .checkout-scroll-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.15rem 1.35rem;
  }

