---
interface Props {
  cartCount?: number;
}

const { cartCount = 0 } = Astro.props;

const navLinks: { label: string; href: string; badge?: string }[] = [
  { label: 'Shop All Bestsellers', href: '#bestsellers' },
  { label: 'Pantry Categories', href: '#categories' },
  { label: 'Quality Standards', href: '#why-manneeds' }
];
---

<!-- Top Announcement Ticker -->
<div class="announcement-bar" id="announcement">
  <div class="container announcement-content">
    <div class="announcement-item">
      <span class="ticker-highlight">⚡ FLASH SALE:</span>
      <span>Use code <strong class="coupon-code">MANNEEDS15</strong> for 15% OFF your box</span>
    </div>
    <div class="announcement-divider">|</div>
    <div class="announcement-item hide-on-mobile">
      <span>🌿 100% Clean Plant-Based & Vegan Certified</span>
    </div>
    <div class="announcement-divider hide-on-mobile">|</div>
    <div class="announcement-item hide-on-mobile">
      <span>🚚 Free Express Shipping on ₹499+</span>
    </div>
  </div>
</div>

<header class="navbar-wrapper" id="main-header">
  <div class="container navbar-container">
    <!-- ManNeeds Brand Logo -->
    <a href="/" class="brand-logo" aria-label="ManNeeds">
      <div class="brand-logo-wrap">
        <span class="brand-name">MAN<span class="brand-highlight">NEEDS</span></span>
      </div>
    </a>

    <!-- Header Actions -->
    <div class="nav-actions">
      <!-- Dark Mode Toggle Button -->
      <button class="action-icon-btn theme-toggle-btn" id="theme-toggle-btn" aria-label="Toggle Dark Mode" title="Toggle Dark/Light Mode">
        <!-- Sun icon (shown in dark mode) -->
        <svg class="theme-icon sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="theme-icon moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Search Button -->
      <button class="action-icon-btn" aria-label="Search Products" id="search-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Cart Button -->
      <button class="action-icon-btn cart-btn" aria-label="View Shopping Cart" id="cart-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-badge" style={cartCount > 0 ? '' : 'display: none;'}>{cartCount}</span>
      </button>

      <!-- Shop Now Primary Button -->
      <a href="#bestsellers" class="btn btn-primary nav-cta">
        <span>Shop Bestsellers</span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button class="mobile-toggle" id="mobile-toggle-btn" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="bar bar-top"></span>
        <span class="bar bar-mid"></span>
        <span class="bar bar-bot"></span>
      </button>
    </div>

    <!-- Expandable Search Bar in Header -->
    <div class="nav-search-bar" id="nav-search-bar" aria-hidden="true">
      <div class="nav-search-inner">
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="search" 
          id="nav-search-input" 
          placeholder="Search 23 clean products (e.g. Ajwain Honey, Okra, Peri Peri, Moringa)..." 
          autocomplete="off" 
          aria-label="Search products"
        />
        <span class="search-shortcut-badge">ESC</span>
        <button type="button" class="search-close-btn" id="nav-search-close-btn" aria-label="Close Search Bar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu" id="mobile-nav-menu">
    <div class="container mobile-menu-inner">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li class="mobile-nav-item">
            <a href={link.href} class="mobile-nav-link">
              <span>{link.label}</span>
              {link.badge && <span class="nav-badge">{link.badge}</span>}
            </a>
          </li>
        ))}
        <li class="mobile-nav-item">
          <button type="button" class="mobile-nav-link mobile-theme-btn" id="mobile-theme-toggle-btn">
            <span>Appearance</span>
            <span class="mobile-theme-pill" id="mobile-theme-status">🌙 Dark</span>
          </button>
        </li>
      </ul>
      <div class="mobile-cta-wrap">
        <a href="#bestsellers" class="btn btn-primary" style="width: 100%;">
          Explore All Essentials
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Ticker */
  .announcement-bar {
    background: var(--mn-primary);
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 0;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(229, 169, 60, 0.2);
  }

  .announcement-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
  }

  .ticker-highlight {
    color: var(--mn-accent-gold);
    font-weight: 800;
    margin-right: 0.35rem;
  }

  .coupon-code {
    background: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    font-weight: 800;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .announcement-divider {
    color: rgba(255, 255, 255, 0.3);
  }

  .hide-on-mobile {
    display: none;
  }

  @media (min-width: 768px) {
    .hide-on-mobile {
      display: inline-flex;
    }
  }

  /* Main Navbar */
  .navbar-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(253, 251, 247, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 2px 12px rgba(30, 70, 32, 0.04);
    transition: all var(--transition-smooth);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* Brand Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-logo-wrap {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 900;
    color: #000000;
    letter-spacing: -0.03em;
    transition: color 0.25s ease;
  }

  .brand-highlight {
    color: #000000;
    transition: color 0.25s ease;
  }


  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .action-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    background: var(--bg-subtle);
    position: relative;
    transition: all var(--transition-smooth);
    border: 1px solid transparent;
  }

  .action-icon-btn:hover {
    color: var(--mn-cta);
    background: var(--bg-tint-orange);
    border-color: var(--border-accent);
    transform: translateY(-1px);
  }

  .cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background: var(--mn-cta);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 800;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(217, 107, 39, 0.4);
  }

  .nav-cta {
    display: none;
    padding: 0.65rem 1.35rem;
    font-size: 0.9rem;
  }

  @media (min-width: 680px) {
    .nav-cta {
      display: inline-flex;
    }
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 40px;
    height: 40px;
    padding: 11px 9px;
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
  }

  @media (min-width: 980px) {
    .mobile-toggle {
      display: none;
    }
  }

  .bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: all 0.25s ease-in-out;
  }

  /* Mobile Menu */
  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-menu.open {
    max-height: 460px;
  }

  .mobile-menu-inner {
    padding-top: 1rem;
    padding-bottom: 1.75rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-bottom: 1px solid #F3F4F6;
  }

  .mobile-nav-link:hover {
    color: var(--mn-orange);
    padding-left: 0.5rem;
  }

  .mobile-cta-wrap {
    margin-top: 1.5rem;
  }

  .mobile-toggle.active .bar-top {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-toggle.active .bar-mid {
    opacity: 0;
  }
  .mobile-toggle.active .bar-bot {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Expandable Search Bar in Header */
  .nav-search-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    z-index: 1010;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-search-bar.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-search-inner {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #F9FAFB;
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 0.45rem 1rem;
    transition: border-color var(--transition-fast);
  }

  .nav-search-inner:focus-within {
    border-color: var(--mn-orange);
    background: #FFFFFF;
    box-shadow: 0 0 0 4px rgba(255, 104, 56, 0.12);
  }

  .search-input-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  #nav-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .search-shortcut-badge {
    display: none;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    background: #E5E7EB;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  @media (min-width: 640px) {
    .search-shortcut-badge {
      display: inline-block;
    }
  }

  .search-close-btn {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    border: none;
    background: transparent;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .search-close-btn:hover {
    background: #F3F4F6;
    color: var(--text-primary);
  }

  /* Theme Toggle Button Styles */
  .theme-toggle-btn {
    position: relative;
    overflow: hidden;
  }

  .theme-toggle-btn .sun-icon {
    display: none;
    color: #F5BA42;
    transition: transform 0.3s ease;
  }

  .theme-toggle-btn .moon-icon {
    display: block;
    color: var(--text-secondary);
    transition: transform 0.3s ease;
  }

  :global(html.dark) .theme-toggle-btn .sun-icon,
  :global([data-theme="dark"]) .theme-toggle-btn .sun-icon {
    display: block;
    transform: rotate(360deg);
  }

  :global(html.dark) .theme-toggle-btn .moon-icon,
  :global([data-theme="dark"]) .theme-toggle-btn .moon-icon {
    display: none;
  }

  :global(html.dark) .theme-toggle-btn,
  :global([data-theme="dark"]) .theme-toggle-btn {
    background: var(--bg-subtle);
    border-color: var(--border-subtle);
  }

  /* Mobile Theme Button */
  .mobile-theme-btn {
    width: 100%;
    cursor: pointer;
    background: none;
    border: none;
    text-align: left;
  }

  .mobile-theme-pill {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--bg-subtle);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  /* Dark mode overrides for navbar components */
  :global(html.dark) .navbar-wrapper,
  :global([data-theme="dark"]) .navbar-wrapper {
    background: rgba(17, 21, 26, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(html.dark) .brand-name,
  :global([data-theme="dark"]) .brand-name {
    color: #FFFFFF;
  }

  :global(html.dark) .brand-highlight,
  :global([data-theme="dark"]) .brand-highlight {
    color: #FFFFFF;
  }

  :global(html.dark) .mobile-menu,
  :global([data-theme="dark"]) .mobile-menu {
    background: var(--bg-surface);
    border-bottom-color: var(--border-subtle);
  }

  :global(html.dark) .mobile-nav-link,
  :global([data-theme="dark"]) .mobile-nav-link {
    color: var(--text-secondary);
    border-bottom-color: var(--border-subtle);
  }

  :global(html.dark) .nav-search-bar,
  :global([data-theme="dark"]) .nav-search-bar {
    background: var(--bg-surface);
  }

  :global(html.dark) .nav-search-inner,
  :global([data-theme="dark"]) .nav-search-inner {
    background: var(--bg-subtle);
    border-color: var(--border-subtle);
  }

  :global(html.dark) #nav-search-input,
  :global([data-theme="dark"]) #nav-search-input {
    color: var(--text-primary);
  }

  :global(html.dark) .search-shortcut-badge,
  :global([data-theme="dark"]) .search-shortcut-badge {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
  }
</style>

<script>
  // Dark Mode Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  const mobileThemeBtn = document.getElementById('mobile-theme-toggle-btn');
  const mobileThemeStatus = document.getElementById('mobile-theme-status');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (mobileThemeStatus) {
      mobileThemeStatus.textContent = isDark ? '☀️ Light' : '🌙 Dark';
    }
    if (themeToggleBtn) {
      themeToggleBtn.setAttribute('title', isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode');
      themeToggleBtn.setAttribute('aria-label', isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode');
    }
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const newTheme = isDark ? 'light' : 'dark';
    if (newTheme === 'dark') {
      document.documentElement.classList.add('dark');
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.classList.remove('dark');
      document.documentElement.setAttribute('data-theme', 'light');
    }
    try {
      localStorage.setItem('manneeds_theme', newTheme);
    } catch {}
    updateThemeUI();
    window.dispatchEvent(new CustomEvent('manneeds-theme-changed', { detail: { theme: newTheme } }));
  }

  themeToggleBtn?.addEventListener('click', toggleTheme);
  mobileThemeBtn?.addEventListener('click', toggleTheme);
  updateThemeUI();

  // Mobile Hamburger Toggle
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const mobileMenu = document.getElementById('mobile-nav-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      toggleBtn.classList.toggle('active');
      mobileMenu.classList.toggle('open');
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.classList.remove('active');
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('open');
      });
    });
  }

  // Header Instant Search Bar
  const searchBtn = document.getElementById('search-btn');
  const searchBar = document.getElementById('nav-search-bar');
  const searchInput = document.getElementById('nav-search-input') as HTMLInputElement;
  const searchClose = document.getElementById('nav-search-close-btn');

  function openSearch() {
    if (searchBar && searchInput) {
      searchBar.classList.add('active');
      searchBar.setAttribute('aria-hidden', 'false');
      searchInput.focus();
    }
  }

  function closeSearch() {
    if (searchBar && searchInput) {
      searchBar.classList.remove('active');
      searchBar.setAttribute('aria-hidden', 'true');
    }
  }

  if (searchBtn) searchBtn.addEventListener('click', openSearch);
  if (searchClose) searchClose.addEventListener('click', closeSearch);

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value;
      window.dispatchEvent(new CustomEvent('manneeds-search', { detail: { query } }));
      const bestsellersSection = document.getElementById('bestsellers');
      if (bestsellersSection && window.scrollY < bestsellersSection.offsetTop - 140) {
        bestsellersSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') {
      closeSearch();
    }
  });
</script>
